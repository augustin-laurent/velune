<UserControl
    x:Class="Velune.Windows.Controls.AnnotationPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:Velune.Domain.Annotations"
    xmlns:services="using:Velune.Windows.Services"
    xmlns:vm="using:Velune.Windows.ViewModels">

  <UserControl.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <services:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <services:HexToBrushConverter x:Key="HexToBrush" />
    <services:SignaturePadPointCollectionConverter x:Key="SignaturePadPointCollection" />
  </UserControl.Resources>
        <Border
                Width="420"
                VerticalAlignment="Stretch"
                Background="{ThemeResource PanelDeepBrush}"
                BorderBrush="{ThemeResource PanelLineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{Binding ActiveDocumentTab.IsAnnotationsPanelOpen, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
          <Grid x:Name="AnnotationPanelContent"
                x:Load="{x:Bind ViewModel.IsAnnotationsPanelVisible, Mode=OneWay}"
                Padding="20,20,20,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Labels.Annotations, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Labels.AnnotationDescriptionShort, Mode=OneWay}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Width="28"
                      AutomationProperties.AutomationId="AnnotationsPanelCloseButton"
                      Height="28"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Command="{Binding ToggleAnnotationsPanelCommand, Mode=OneWay}"
                      ToolTipService.ToolTip="{Binding Labels.Close, Mode=OneWay}">
                <FontIcon Glyph="&#xE8BB;"
                          FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource TextSecondaryBrush}"
                          FontSize="12" />
              </Button>
            </Grid>

            <Border Grid.Row="1"
                    Height="38"
                    Margin="0,14,0,14"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
              <Grid Margin="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{ThemeResource ActiveToolBgBrush}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{Binding IsAnnotationToolsTabSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                  <Rectangle Height="2"
                             Width="40"
                             RadiusX="1"
                             RadiusY="1"
                             Fill="{ThemeResource AccentBrush}"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,2" />
                </Border>
                <Button Grid.Column="0"
                        AutomationProperties.AutomationId="AnnotationsToolsTabButton"
                        Height="32"
                        MinWidth="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding SelectAnnotationPanelTabCommand, Mode=OneWay}"
                        CommandParameter="Tools"
                        AutomationProperties.Name="{Binding Labels.AnnotationToolsTab, Mode=OneWay}">
                  <TextBlock Text="{Binding Labels.AnnotationToolsTab, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="13"
                             FontWeight="SemiBold" />
                </Button>

                <Border Grid.Column="1"
                        Background="{ThemeResource ActiveToolBgBrush}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{Binding IsAnnotationCommentsTabSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                  <Rectangle Height="2"
                             Width="40"
                             RadiusX="1"
                             RadiusY="1"
                             Fill="{ThemeResource AccentBrush}"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,2" />
                </Border>
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="AnnotationsCommentsTabButton"
                        Height="32"
                        MinWidth="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding SelectAnnotationPanelTabCommand, Mode=OneWay}"
                        CommandParameter="Comments"
                        AutomationProperties.Name="{Binding Labels.AnnotationCommentsTab, Mode=OneWay}">
                  <TextBlock Text="{Binding Labels.AnnotationCommentsTab, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="13"
                             FontWeight="SemiBold" />
                </Button>
              </Grid>
            </Border>

            <Grid Grid.Row="2"
                  RowSpacing="8"
                  HorizontalAlignment="Stretch"
                  Visibility="{Binding IsAnnotationToolsAppearancePanelVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="{Binding Labels.AnnotationActiveTool, Mode=OneWay}"
                         Foreground="{ThemeResource PanelLabelBrush}"
                         FontSize="13" />
              <Button Grid.Row="1"
                      AutomationProperties.AutomationId="AnnotationActiveToolMenuButton"
                      Height="42"
                      Background="{ThemeResource CardBrush}"
                      BorderBrush="{ThemeResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{ThemeResource OverlayCornerRadius}"
                      Padding="14,0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      ToolTipService.ToolTip="{Binding ActiveAnnotationToolLabel, Mode=OneWay}"
                      AutomationProperties.Name="{Binding ActiveAnnotationToolLabel, Mode=OneWay}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolSelectMenuItem" Text="{Binding Labels.Select, Mode=OneWay}" Command="{Binding SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Select" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolHighlightMenuItem" Text="{Binding Labels.Highlight, Mode=OneWay}" Command="{Binding SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Highlight" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolInkMenuItem" Text="{Binding Labels.Ink, Mode=OneWay}" Command="{Binding SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Ink" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolTextMenuItem" Text="{Binding Labels.Text, Mode=OneWay}" Command="{Binding SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Text" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolNoteMenuItem" Text="{Binding Labels.Note, Mode=OneWay}" Command="{Binding SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Note" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolRectangleMenuItem" Text="{Binding Labels.Rectangle, Mode=OneWay}" Command="{Binding SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Rectangle" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolSignatureMenuItem" Text="{Binding Labels.Signature, Mode=OneWay}" Command="{Binding SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Signature" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolStampMenuItem" Text="{Binding Labels.Stamp, Mode=OneWay}" Command="{Binding SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Stamp" />
                  </MenuFlyout>
                </Button.Flyout>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border Width="22"
                          Height="22"
                          Background="{Binding SelectedAnnotationColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          VerticalAlignment="Center" />

                  <TextBlock Grid.Column="1"
                             Text="{Binding ActiveAnnotationToolLabel, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="14"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center" />

                  <FontIcon Grid.Column="2"
                            Glyph="&#xE70D;"
                            FontFamily="Segoe Fluent Icons"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            FontSize="11"
                            VerticalAlignment="Center" />
                </Grid>
              </Button>
            </Grid>

            <StackPanel Grid.Row="3"
                        Margin="0,12,0,0"
                        Spacing="10"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding IsAnnotationToolsTabSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
              <TextBlock Text="{Binding Labels.AnnotationQuickTools, Mode=OneWay}"
                         Foreground="{ThemeResource PanelLabelBrush}"
                         FontSize="13" />
              <ItemsControl AutomationProperties.AutomationId="AnnotationQuickToolsList"
                            ItemsSource="{Binding AnnotationTools, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   MaximumRowsOrColumns="4"
                                   ItemWidth="90"
                                   ItemHeight="68" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WindowsAnnotationToolItem">
                    <Button Width="82"
                            AutomationProperties.AutomationId="AnnotationQuickToolButton"
                            Height="58"
                            Margin="0"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Background="{x:Bind services:XamlBindingHelpers.BoolToSelectedToolBackground(IsSelected), Mode=OneWay}"
                            BorderBrush="{ThemeResource ButtonBorderBrush}"
                            BorderThickness="1"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                            Click="OnAnnotationToolClicked">
                      <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="20" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="6"
                          Visibility="{Binding ShowAnnotationTextEditor, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <TextBlock Text="{Binding Labels.AnnotationText, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <TextBox AutomationProperties.AutomationId="AnnotationTextDraftTextBox"
                         MinHeight="78"
                         Padding="10,8"
                         Background="{ThemeResource InputBrush}"
                         BorderBrush="{ThemeResource InputBorderBrush}"
                         BorderThickness="1"
                         CornerRadius="{ThemeResource OverlayCornerRadius}"
                         Foreground="{ThemeResource TextPrimaryBrush}"
                         PlaceholderText="{Binding Labels.AnnotationTextPlaceholder, Mode=OneWay}"
                         Text="{Binding AnnotationTextDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         KeyDown="OnAnnotationTextDraftKeyDown" />
              </StackPanel>

              <StackPanel Spacing="10"
                          Visibility="{Binding ShowTextStyleControls, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <TextBlock Text="{Binding Labels.AnnotationTextProperties, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                  </Grid.ColumnDefinitions>
                  <ComboBox AutomationProperties.AutomationId="AnnotationFontFamilyComboBox"
                            Header="{Binding Labels.AnnotationFontFamily, Mode=OneWay}"
                            ItemsSource="{Binding AnnotationFontFamilyOptions, Mode=OneWay}"
                            SelectedItem="{Binding AnnotationFontFamily, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource InputBrush}"
                            BorderBrush="{ThemeResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}" />
                  <NumberBox Grid.Column="1"
                             AutomationProperties.AutomationId="AnnotationFontSizeNumberBox"
                             Header="{Binding Labels.AnnotationFontSize, Mode=OneWay}"
                             Minimum="6"
                             Maximum="144"
                             SmallChange="1"
                             SpinButtonPlacementMode="Compact"
                             Value="{Binding AnnotationFontSize, Mode=TwoWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ToggleButton Width="38" Height="36" Padding="0"
                                AutomationProperties.AutomationId="AnnotationTextBoldToggleButton"
                                AutomationProperties.Name="{Binding Labels.AnnotationBold, Mode=OneWay}"
                                IsChecked="{Binding AnnotationTextBold, Mode=TwoWay}">
                    <TextBlock Text="B" FontWeight="SemiBold" />
                  </ToggleButton>
                  <ToggleButton Width="38" Height="36" Padding="0"
                                AutomationProperties.AutomationId="AnnotationTextItalicToggleButton"
                                AutomationProperties.Name="{Binding Labels.AnnotationItalic, Mode=OneWay}"
                                IsChecked="{Binding AnnotationTextItalic, Mode=TwoWay}">
                    <TextBlock Text="I" FontStyle="Italic" />
                  </ToggleButton>
                  <ToggleButton Width="38" Height="36" Padding="0"
                                AutomationProperties.AutomationId="AnnotationTextUnderlineToggleButton"
                                AutomationProperties.Name="{Binding Labels.AnnotationUnderline, Mode=OneWay}"
                                IsChecked="{Binding AnnotationTextUnderline, Mode=TwoWay}">
                    <TextBlock Text="U" TextDecorations="Underline" />
                  </ToggleButton>
                  <ToggleButton Width="38" Height="36" Padding="0"
                                AutomationProperties.AutomationId="AnnotationTextAlignLeftToggleButton"
                                AutomationProperties.Name="{Binding Labels.AnnotationAlignLeft, Mode=OneWay}"
                                IsChecked="{Binding IsTextAlignLeftSelected, Mode=OneWay}"
                                Command="{Binding SetTextAlignmentCommand, Mode=OneWay}"
                                CommandParameter="Left">
                    <FontIcon Glyph="&#xE8E4;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                  </ToggleButton>
                  <ToggleButton Width="38" Height="36" Padding="0"
                                AutomationProperties.AutomationId="AnnotationTextAlignCenterToggleButton"
                                AutomationProperties.Name="{Binding Labels.AnnotationAlignCenter, Mode=OneWay}"
                                IsChecked="{Binding IsTextAlignCenterSelected, Mode=OneWay}"
                                Command="{Binding SetTextAlignmentCommand, Mode=OneWay}"
                                CommandParameter="Center">
                    <FontIcon Glyph="&#xE8E3;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                  </ToggleButton>
                  <ToggleButton Width="38" Height="36" Padding="0"
                                AutomationProperties.AutomationId="AnnotationTextAlignRightToggleButton"
                                AutomationProperties.Name="{Binding Labels.AnnotationAlignRight, Mode=OneWay}"
                                IsChecked="{Binding IsTextAlignRightSelected, Mode=OneWay}"
                                Command="{Binding SetTextAlignmentCommand, Mode=OneWay}"
                                CommandParameter="Right">
                    <FontIcon Glyph="&#xE8E2;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                  </ToggleButton>
                </StackPanel>
                <TextBlock Text="{Binding Labels.AnnotationTextColor, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <ItemsControl AutomationProperties.AutomationId="AnnotationTextColorList"
                              ItemsSource="{Binding AnnotationColorOptions, Mode=OneWay}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WindowsAnnotationColorItem">
                      <Button Width="28"
                              AutomationProperties.AutomationId="AnnotationTextColorButton"
                              Height="28"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTipService.ToolTip="{x:Bind Hex, Mode=OneWay}"
                              Click="OnAnnotationColorClicked">
                        <Grid>
                          <Ellipse Width="22"
                                   Height="22"
                                   Fill="{x:Bind services:XamlBindingHelpers.BrushFromHex(Hex, 255), Mode=OneWay}" />
                          <Ellipse Width="28"
                                   Height="28"
                                   Stroke="{ThemeResource AccentBrush}"
                                   StrokeThickness="3"
                                   Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Labels.AnnotationBackground, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button AutomationProperties.AutomationId="AnnotationTextTransparentBackgroundButton"
                          Content="{Binding Labels.AnnotationTransparent, Mode=OneWay}"
                          Click="OnAnnotationTextTransparentBackgroundClicked" />
                  <ItemsControl AutomationProperties.AutomationId="AnnotationTextBackgroundColorList"
                                ItemsSource="{Binding AnnotationFillColorOptions, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WindowsAnnotationColorItem">
                        <Button Width="28"
                                AutomationProperties.AutomationId="AnnotationTextBackgroundColorButton"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="{x:Bind Hex, Mode=OneWay}"
                                Click="OnAnnotationFillColorClicked">
                          <Grid>
                            <Ellipse Width="22"
                                     Height="22"
                                     Fill="{x:Bind services:XamlBindingHelpers.BrushFromHex(Hex, 255), Mode=OneWay}" />
                            <Ellipse Width="28"
                                     Height="28"
                                     Stroke="{ThemeResource AccentBrush}"
                                     StrokeThickness="3"
                                     Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <CheckBox AutomationProperties.AutomationId="AnnotationTextBorderCheckBox"
                          Content="{Binding Labels.AnnotationBorder, Mode=OneWay}"
                          IsChecked="{Binding AnnotationBorderEnabled, Mode=TwoWay}" />
                <StackPanel Spacing="6"
                            Visibility="{Binding AnnotationBorderEnabled, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                  <TextBlock Text="{Binding Labels.AnnotationBorderColor, Mode=OneWay}"
                             Foreground="{ThemeResource PanelLabelBrush}"
                             FontSize="13" />
                  <ItemsControl AutomationProperties.AutomationId="AnnotationTextBorderColorList"
                                ItemsSource="{Binding AnnotationColorOptions, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WindowsAnnotationColorItem">
                        <Button Width="28"
                                AutomationProperties.AutomationId="AnnotationTextBorderColorButton"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="{x:Bind Hex, Mode=OneWay}"
                                Click="OnAnnotationBorderColorClicked">
                          <Ellipse Width="22"
                                   Height="22"
                                   Fill="{x:Bind services:XamlBindingHelpers.BrushFromHex(Hex, 255), Mode=OneWay}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <NumberBox AutomationProperties.AutomationId="AnnotationTextBorderWidthNumberBox"
                           Header="{Binding Labels.AnnotationBorderWidth, Mode=OneWay}"
                           Minimum="0"
                           Maximum="12"
                           SmallChange="1"
                           SpinButtonPlacementMode="Compact"
                           Value="{Binding AnnotationBorderWidth, Mode=TwoWay}"
                           Visibility="{Binding AnnotationBorderEnabled, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
              </StackPanel>

              <StackPanel Spacing="10"
                          Visibility="{Binding ShowSignatureControls, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Labels.SignatureLibrary, Mode=OneWay}"
                             Foreground="{ThemeResource PanelLabelBrush}"
                             FontSize="13"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          AutomationProperties.AutomationId="SignatureImportImageButton"
                          Height="32"
                          MinWidth="0"
                          Padding="10,0"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Background="{ThemeResource CardBrush}"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          Command="{Binding ImportSignatureAssetCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <FontIcon Glyph="&#xE8E5;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13" />
                      <TextBlock Text="{Binding Labels.SignatureImportImage, Mode=OneWay}"
                                 FontSize="12" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2"
                          AutomationProperties.AutomationId="SignatureDeleteSelectedButton"
                          Width="32"
                          Height="32"
                          Padding="0"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Background="Transparent"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          Command="{Binding DeleteSelectedSignatureAssetCommand, Mode=OneWay}"
                          CommandParameter="{Binding SelectedSignatureAssetId, Mode=OneWay}"
                          ToolTipService.ToolTip="{Binding Labels.SignatureDeleteSelected, Mode=OneWay}"
                          AutomationProperties.Name="{Binding Labels.SignatureDeleteSelected, Mode=OneWay}">
                    <FontIcon Glyph="&#xE74D;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="13" />
                  </Button>
                </Grid>

                <ScrollViewer MaxHeight="132"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSignatureAssets, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                  <ItemsControl AutomationProperties.AutomationId="SignatureAssetsList"
                                ItemsSource="{Binding SignatureAssets, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="domain:SignatureAsset">
                        <Border Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Padding="10,8"
                                Margin="0,0,0,6">
                          <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Background="Transparent"
                                    AutomationProperties.AutomationId="SignatureAssetSelectButton"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OnSignatureAssetClicked">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FilePath, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="SignatureAssetDeleteButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnDeleteSignatureAssetClicked">
                              <FontIcon Glyph="&#xE74D;"
                                        FontFamily="Segoe Fluent Icons"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        FontSize="13" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding Labels.SignatureDraw, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <TextBox AutomationProperties.AutomationId="SignatureNameTextBox"
                         Height="36"
                         Padding="10,0"
                         Background="{ThemeResource InputBrush}"
                         BorderBrush="{ThemeResource InputBorderBrush}"
                         BorderThickness="1"
                         CornerRadius="{ThemeResource OverlayCornerRadius}"
                         Foreground="{ThemeResource TextPrimaryBrush}"
                         PlaceholderText="{Binding Labels.SignatureNamePlaceholder, Mode=OneWay}"
                         Text="{Binding SignatureAssetNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Border Height="146"
                        Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="10">
                  <Grid HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Rectangle Width="248"
                               Height="124"
                               Fill="{ThemeResource SignaturePadBgBrush}"
                               RadiusX="4"
                               RadiusY="4" />
                    <Polyline Points="{Binding SignaturePadPoints, Converter={StaticResource SignaturePadPointCollection}, Mode=OneWay}"
                              Stroke="{ThemeResource SignatureInkBrush}"
                              StrokeThickness="2.2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    <Border x:Name="SignaturePadInteractionLayer"
                            AutomationProperties.AutomationId="SignaturePadDrawingSurface"
                            Width="248"
                            Height="124"
                            Background="Transparent"
                            PointerPressed="OnSignaturePadPointerPressed"
                            PointerMoved="OnSignaturePadPointerMoved"
                            PointerReleased="OnSignaturePadPointerReleased"
                            PointerCanceled="OnSignaturePadPointerCanceled" />
                  </Grid>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                  <Button Height="32"
                          AutomationProperties.AutomationId="SignatureClearDrawingButton"
                          MinWidth="0"
                          Padding="10,0"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Background="{ThemeResource CardBrush}"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          Command="{Binding ClearSignatureCaptureCommand, Mode=OneWay}"
                          Content="{Binding Labels.SignatureClearDrawing, Mode=OneWay}" />
                  <Button Height="32"
                          AutomationProperties.AutomationId="SignatureSaveButton"
                          MinWidth="0"
                          Padding="10,0"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Background="{ThemeResource AccentBgBrush}"
                          BorderBrush="{ThemeResource AccentBrush}"
                          BorderThickness="1"
                          Command="{Binding SaveDrawnSignatureAssetCommand, Mode=OneWay}"
                          Content="{Binding Labels.SignatureSave, Mode=OneWay}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Margin="0,2,0,0"
                        Spacing="8"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding IsAnnotationToolsAppearancePanelVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
              <TextBlock Text="{Binding Labels.AnnotationColor, Mode=OneWay}"
                         Foreground="{ThemeResource PanelLabelBrush}"
                         FontSize="13" />
              <ItemsControl AutomationProperties.AutomationId="AnnotationStrokeColorList"
                            ItemsSource="{Binding AnnotationColorOptions, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WindowsAnnotationColorItem">
                    <Button Width="30"
                            AutomationProperties.AutomationId="AnnotationStrokeColorButton"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind Hex, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Hex, Mode=OneWay}"
                            Click="OnAnnotationColorClicked">
                      <Grid>
                        <Ellipse Width="24"
                                 Height="24"
                                 Fill="{x:Bind services:XamlBindingHelpers.BrushFromHex(Hex, 255), Mode=OneWay}" />
                        <Ellipse Width="30"
                                 Height="30"
                                 Stroke="{ThemeResource AccentBrush}"
                                 StrokeThickness="3"
                                 Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                        <Ellipse Width="20"
                                 Height="20"
                                 Stroke="{ThemeResource TextPrimaryBrush}"
                                 StrokeThickness="1"
                                 Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="5"
                        Margin="0,10,0,0"
                        Spacing="6"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding IsAnnotationToolsAppearancePanelVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
              <Grid>
                <TextBlock Text="{Binding Labels.AnnotationOpacity, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <TextBlock Text="{Binding AnnotationOpacityText, Mode=OneWay}"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Right" />
              </Grid>
              <Slider AutomationProperties.AutomationId="AnnotationOpacitySlider"
                      Minimum="0"
                      Maximum="100"
                      Value="{Binding AnnotationOpacity, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="6"
                        Margin="0,10,0,0"
                        Spacing="8"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowRectangleFillControls, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
              <CheckBox AutomationProperties.AutomationId="AnnotationFillCheckBox"
                        Content="{Binding Labels.AnnotationFill, Mode=OneWay}"
                        IsChecked="{Binding AnnotationFillEnabled, Mode=TwoWay}" />
              <StackPanel Spacing="6"
                          Visibility="{Binding AnnotationFillEnabled, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <TextBlock Text="{Binding Labels.AnnotationFillColor, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <ItemsControl AutomationProperties.AutomationId="AnnotationFillColorList"
                              ItemsSource="{Binding AnnotationFillColorOptions, Mode=OneWay}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WindowsAnnotationColorItem">
                      <Button Width="28"
                              AutomationProperties.AutomationId="AnnotationFillColorButton"
                              Height="28"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTipService.ToolTip="{x:Bind Hex, Mode=OneWay}"
                              Click="OnAnnotationFillColorClicked">
                        <Grid>
                          <Ellipse Width="22"
                                   Height="22"
                                   Fill="{x:Bind services:XamlBindingHelpers.BrushFromHex(Hex, 255), Mode=OneWay}" />
                          <Ellipse Width="28"
                                   Height="28"
                                   Stroke="{ThemeResource AccentBrush}"
                                   StrokeThickness="3"
                                   Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <Border Grid.Row="7"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{ThemeResource AnnotationSeparatorBrush}"
                    BorderThickness="0"
                    Visibility="{Binding IsAnnotationToolsTabSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
              <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                  <TextBlock Text="{Binding Labels.AnnotationCurrent, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="14" />
                  <Border HorizontalAlignment="Right"
                          Padding="10,4"
                          Background="{ThemeResource CardBrush}"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Labels.AnnotationRecent, Mode=OneWay}"
                                 Foreground="{ThemeResource TextPrimaryBrush}"
                                 FontSize="12" />
                      <FontIcon Glyph="&#xE70D;"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                FontSize="10"
                                VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid Grid.Row="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Visibility="{Binding ActiveDocumentTab.HasCurrentPageAnnotations, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <ItemsControl AutomationProperties.AutomationId="CurrentPageAnnotationsList"
                                  ItemsSource="{Binding ActiveDocumentTab.CurrentPageAnnotationOverlays, Mode=OneWay}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WindowsAnnotationOverlayViewModel">
                          <Border Background="{ThemeResource CardBrush}"
                                  AutomationProperties.AutomationId="{x:Bind ListItemAutomationId, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                                  IsTabStop="True"
                                  BorderBrush="{ThemeResource CardBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{ThemeResource OverlayCornerRadius}"
                                  Padding="12,10"
                                  Margin="0,0,0,8"
                                  Opacity="{x:Bind ListItemOpacity, Mode=OneWay}"
                                  KeyDown="OnAnnotationListItemKeyDown"
                                  Tapped="OnAnnotationListItemTapped">
                            <Grid ColumnSpacing="12">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <Grid Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0">
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="{x:Bind services:XamlBindingHelpers.BrushFromHex(StrokeHex, StrokeAlpha), Mode=OneWay}"
                                          FontSize="18" />
                                <FontIcon Glyph="&#xE72E;"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource TextSecondaryBrush}"
                                          FontSize="10"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,-4,-4"
                                          Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsLockIconVisible), Mode=OneWay}" />
                                <FontIcon Glyph="&#xED1A;"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource TextSecondaryBrush}"
                                          FontSize="10"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Bottom"
                                          Margin="-4,0,0,-4"
                                          Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsHiddenIconVisible), Mode=OneWay}" />
                              </Grid>

                              <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind PageLabel, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBlock Text="{x:Bind PreviewText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(HasPreviewText), Mode=OneWay}" />
                              </StackPanel>

                              <StackPanel Grid.Column="2"
                                          Orientation="Horizontal"
                                          Spacing="6"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0">
                                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <Button Width="28"
                                        AutomationProperties.AutomationId="AnnotationListItemMenuButton"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                  <FontIcon Glyph="&#xE712;"
                                            FontFamily="Segoe Fluent Icons"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            FontSize="13" />
                                  <Button.Flyout>
                                    <MenuFlyout>
                                      <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationListEditMenuItem"
                                                      Text="{x:Bind AnnotationMenuEditLabel, Mode=OneWay}"
                                                      Tag="{x:Bind Id, Mode=OneWay}"
                                                      Click="OnAnnotationMenuEditClicked">
                                        <MenuFlyoutItem.Icon>
                                          <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                      <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationListHideMenuItem"
                                                      Text="{x:Bind HideMenuText, Mode=OneWay}"
                                                      Tag="{x:Bind Id, Mode=OneWay}"
                                                      Click="OnAnnotationMenuHideClicked">
                                        <MenuFlyoutItem.Icon>
                                          <FontIcon Glyph="&#xED1A;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                      <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationListLockMenuItem"
                                                      Text="{x:Bind LockMenuText, Mode=OneWay}"
                                                      Tag="{x:Bind Id, Mode=OneWay}"
                                                      Click="OnAnnotationMenuLockClicked">
                                        <MenuFlyoutItem.Icon>
                                          <FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                      <MenuFlyoutSeparator />
                                      <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationListDeleteMenuItem"
                                                      Text="{x:Bind AnnotationMenuDeleteLabel, Mode=OneWay}"
                                                      Tag="{x:Bind Id, Mode=OneWay}"
                                                      Click="OnAnnotationMenuDeleteClicked">
                                        <MenuFlyoutItem.Icon>
                                          <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                    </MenuFlyout>
                                  </Button.Flyout>
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <StackPanel VerticalAlignment="Top"
                              HorizontalAlignment="Center"
                              Spacing="10"
                              Margin="0,96,0,0"
                              Visibility="{Binding ActiveDocumentTab.HasCurrentPageAnnotations, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                    <FontIcon Glyph="&#xE90A;"
                              FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource EmptyStateIconBrush}"
                              FontSize="38"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Labels.AnnotationEmptyPage, Mode=OneWay}"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Labels.AnnotationEmptyHint, Mode=OneWay}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"
                               Width="260" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Row="7"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{ThemeResource AnnotationSeparatorBrush}"
                    BorderThickness="0"
                    Visibility="{Binding IsAnnotationCommentsTabSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
              <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                  <TextBlock Text="{Binding Labels.AnnotationCommentsCurrent, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="14" />
                  <Border HorizontalAlignment="Right"
                          Padding="10,4"
                          Background="{ThemeResource CardBrush}"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <TextBlock Text="{Binding ActiveDocumentTab.CurrentPageCommentCountText, Mode=OneWay}"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               FontSize="12" />
                  </Border>
                </Grid>

                <Grid Grid.Row="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Visibility="{Binding ActiveDocumentTab.HasCurrentPageComments, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <ItemsControl AutomationProperties.AutomationId="CurrentPageCommentsList"
                                  ItemsSource="{Binding ActiveDocumentTab.CurrentPageCommentOverlays, Mode=OneWay}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WindowsCommentOverlayViewModel">
                          <Border Background="{ThemeResource CardBrush}"
                                  BorderBrush="{ThemeResource CardBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{ThemeResource OverlayCornerRadius}"
                                  Padding="12,10"
                                  Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <FontIcon Grid.Column="0"
                                        Glyph="&#xE90A;"
                                        FontFamily="Segoe Fluent Icons"
                                        Foreground="{x:Bind services:XamlBindingHelpers.BrushFromHex(StrokeHex, StrokeAlpha), Mode=OneWay}"
                                        FontSize="18"
                                        VerticalAlignment="Top"
                                        Margin="0,2,0,0" />

                              <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           MaxLines="3" />
                                <TextBlock Text="{x:Bind PageLabel, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11" />
                              </StackPanel>

                              <StackPanel Grid.Column="2"
                                          Orientation="Horizontal"
                                          Spacing="6"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0">
                                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <Button Width="28"
                                        AutomationProperties.AutomationId="CommentListItemMenuButton"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTipService.ToolTip="{x:Bind AnnotationDeleteSelectedLabel, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind AnnotationDeleteSelectedLabel, Mode=OneWay}"
                                        Tapped="OnDeleteAnnotationTapped">
                                  <FontIcon Glyph="&#xE712;"
                                            FontFamily="Segoe Fluent Icons"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            FontSize="13" />
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <StackPanel VerticalAlignment="Top"
                              HorizontalAlignment="Center"
                              Spacing="10"
                              Margin="0,96,0,0"
                              Visibility="{Binding ActiveDocumentTab.HasCurrentPageComments, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                    <FontIcon Glyph="&#xE90A;"
                              FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource EmptyStateIconBrush}"
                              FontSize="38"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Labels.AnnotationCommentsEmptyPage, Mode=OneWay}"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Labels.AnnotationCommentsEmptyHint, Mode=OneWay}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"
                               Width="260" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <Button Grid.Row="8"
                    AutomationProperties.AutomationId="AnnotationsPanelCollapseButton"
                    HorizontalAlignment="Right"
                    Width="40"
                    Height="36"
                    Margin="0,8,0,0"
                    Padding="0"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Command="{Binding ToggleAnnotationsPanelCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{Binding Labels.Annotations, Mode=OneWay}"
                    AutomationProperties.Name="{Binding Labels.Annotations, Mode=OneWay}">
              <TextBlock Text="&#x00AB;"
                         Foreground="{ThemeResource TextPrimaryBrush}"
                         FontSize="22" />
            </Button>
          </Grid>
        </Border>
</UserControl>

