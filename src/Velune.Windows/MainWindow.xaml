                      AutomationProperties.AutomationId="PagesPanelFilterButton"
                      Height="28"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      ToolTipService.ToolTip="Filter">
                <FontIcon Glyph="&#xE71C;"
                          FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource TextSecondaryBrush}"
                          FontSize="14" />
