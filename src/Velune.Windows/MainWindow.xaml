                        Command="{x:Bind ViewModel.ToggleAnnotationsPanelCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Annotations, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Annotations, Mode=OneWay}">
                  <FontIcon Glyph="&#xE924;" FontFamily="Segoe Fluent Icons" />
                </Button>
              </StackPanel>
            </Border>

