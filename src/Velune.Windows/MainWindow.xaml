<Window
    x:Class="Velune.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Velune.Windows.Controls"
    xmlns:domain="using:Velune.Domain.Annotations"
    xmlns:services="using:Velune.Windows.Services"
    xmlns:vm="using:Velune.Windows.ViewModels">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root"
        Background="Transparent">

    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="C"
                           Modifiers="Control"
                           Invoked="OnCopySelectedTextKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="F"
                           Modifiers="Control"
                           Invoked="OnSearchKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="S"
                           Modifiers="Control"
                           Invoked="OnSaveKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Z"
                           Modifiers="Control"
                           Invoked="OnUndoKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Y"
                           Modifiers="Control"
                           Invoked="OnRedoKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="B"
                           Modifiers="Control"
                           Invoked="OnToggleTextBoldKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="I"
                           Modifiers="Control"
                           Invoked="OnToggleTextItalicKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="U"
                           Modifiers="Control"
                           Invoked="OnToggleTextUnderlineKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Escape"
                           Invoked="OnEscapeKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Delete"
                           Invoked="OnDeleteAnnotationKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Right"
                           Modifiers="Shift"
                           Invoked="OnExtendSelectionRightKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Left"
                           Modifiers="Shift"
                           Invoked="OnShrinkSelectionLeftKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Right"
                           Modifiers="Control,Shift"
                           Invoked="OnExtendSelectionWordRightKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Left"
                           Modifiers="Control,Shift"
                           Invoked="OnShrinkSelectionWordLeftKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="R"
                           Modifiers="Control"
                           Invoked="OnRotateRightKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="R"
                           Modifiers="Control,Shift"
                           Invoked="OnRotateLeftKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Number0"
                           Modifiers="Control"
                           Invoked="OnFitPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Number1"
                           Modifiers="Control"
                           Invoked="OnActualSizeKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="H"
                           Modifiers="Control,Shift"
                           Invoked="OnFlipHorizontalKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Right"
                           Invoked="OnNextPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Left"
                           Invoked="OnPreviousPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="PageDown"
                           Invoked="OnNextPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="PageUp"
                           Invoked="OnPreviousPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Add"
                           Modifiers="Control"
                           Invoked="OnZoomInKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Subtract"
                           Modifiers="Control"
                           Invoked="OnZoomOutKeyboardAcceleratorInvoked" />
    </Grid.KeyboardAccelerators>

    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="Resources/MainWindowStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Grid.Resources>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="RibbonAdaptiveStates">
        <VisualState x:Name="RibbonCompact">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SearchBoxBorder.MinWidth" Value="420" />
            <Setter Target="SearchBoxBorder.MaxWidth" Value="1200" />
            <Setter Target="AnnotateBtnNote.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnStamp.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnInk.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnErase.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>

        <VisualState x:Name="RibbonMedium">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1550" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SearchBoxBorder.MinWidth" Value="520" />
            <Setter Target="SearchBoxBorder.MaxWidth" Value="1200" />
            <Setter Target="AnnotateBtnNote.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnStamp.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnInk.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnErase.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>

        <VisualState x:Name="RibbonWide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1750" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SearchBoxBorder.MinWidth" Value="640" />
            <Setter Target="SearchBoxBorder.MaxWidth" Value="1400" />
            <Setter Target="AnnotateBtnNote.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnStamp.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnInk.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnErase.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>

        <VisualState x:Name="RibbonExtraWide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1950" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SearchBoxBorder.MinWidth" Value="760" />
            <Setter Target="SearchBoxBorder.MaxWidth" Value="1800" />
            <Setter Target="AnnotateBtnNote.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnStamp.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnInk.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnErase.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="50" />
      <RowDefinition Height="40" />
      <RowDefinition Height="106" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBarDragRegion"
          Grid.Row="0"
          Padding="18,0,150,0"
          Background="{ThemeResource TitleBarBgBrush}">

      <Border x:Name="TitleBarDragHandle"
              Margin="-18,0,-150,0"
              Background="{ThemeResource TitleBarBgBrush}" />

      <StackPanel x:Name="TitleBarInteractiveRegion"
                  Orientation="Horizontal"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Spacing="4">
        <controls:DocumentTabsBar ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1"
          Background="{ThemeResource MenuBarBrush}"
          BorderBrush="{ThemeResource MenuBarBorderBrush}"
          BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal"
                  Padding="18,0,0,0"
                  Spacing="4"
                  VerticalAlignment="Center">
        <Button Content="{x:Bind ViewModel.Labels.File, Mode=OneWay}"
                AutomationProperties.AutomationId="TopNavFileButton"
                Style="{StaticResource TopNavButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem AutomationProperties.AutomationId="FileOpenMenuItem" Text="{x:Bind ViewModel.Labels.Open, Mode=OneWay}" Command="{x:Bind ViewModel.OpenCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="FileSaveMenuItem" Text="{x:Bind ViewModel.Labels.Save, Mode=OneWay}" Command="{x:Bind ViewModel.SaveDocumentCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="FileSaveAsMenuItem" Text="{x:Bind ViewModel.Labels.SaveAs, Mode=OneWay}" Command="{x:Bind ViewModel.SaveDocumentAsCommand, Mode=OneWay}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="FileMergeMenuItem" Text="{x:Bind ViewModel.Labels.Merge, Mode=OneWay}" Command="{x:Bind ViewModel.MergeCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="FilePrintMenuItem" Text="{x:Bind ViewModel.Labels.Print, Mode=OneWay}" Command="{x:Bind ViewModel.PrintCommand, Mode=OneWay}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="FileCloseTabMenuItem" Text="{x:Bind ViewModel.Labels.CloseTab, Mode=OneWay}" Click="OnCloseActiveTabMenuClicked" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Grid>
          <Button Content="{x:Bind ViewModel.Labels.RibbonHome, Mode=OneWay}"
                  AutomationProperties.AutomationId="TopNavHomeButton"
                  Style="{StaticResource TopNavButtonStyle}"
                  FontWeight="SemiBold" />
          <Rectangle Height="3"
                     Fill="{ThemeResource AccentBrush}"
                     VerticalAlignment="Bottom"
                     Margin="14,0"
                     RadiusX="1"
                     RadiusY="1"
                     Opacity="0.8">
            <Rectangle.OpacityTransition>
              <ScalarTransition Duration="0:0:0.15" />
            </Rectangle.OpacityTransition>
          </Rectangle>
        </Grid>

        <Button Content="{x:Bind ViewModel.Labels.View, Mode=OneWay}"
                AutomationProperties.AutomationId="TopNavViewButton"
                Style="{StaticResource TopNavButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewPagesMenuItem" Text="{x:Bind ViewModel.Labels.Pages, Mode=OneWay}" Command="{x:Bind ViewModel.TogglePagesPanelCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewInfoMenuItem" Text="{x:Bind ViewModel.Labels.Info, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleInfoPanelCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewSearchMenuItem" Text="{x:Bind ViewModel.Labels.Search, Mode=OneWay}" Command="{x:Bind ViewModel.OpenSearchCommand, Mode=OneWay}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewPageOrganizerMenuItem" Text="{x:Bind ViewModel.Labels.PageOrganizer, Mode=OneWay}" Click="OnOpenPageOrganizerClicked" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewZoomFitMenuItem" Text="{x:Bind ViewModel.Labels.ZoomFit, Mode=OneWay}" Command="{x:Bind ViewModel.FitPageCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewZoomActualMenuItem" Text="{x:Bind ViewModel.Labels.ZoomActual, Mode=OneWay}" Command="{x:Bind ViewModel.ActualSizeCommand, Mode=OneWay}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Content="{x:Bind ViewModel.Labels.MenuSelection, Mode=OneWay}"
                AutomationProperties.AutomationId="TopNavSelectionButton"
                Style="{StaticResource TopNavButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionRotateLeftMenuItem" Text="{x:Bind ViewModel.Labels.PageRotateLeft, Mode=OneWay}" Click="OnRibbonRotateLeftClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                      <ScaleTransform ScaleX="-1" />
                    </FontIcon.RenderTransform>
                  </FontIcon>
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionRotateRightMenuItem" Text="{x:Bind ViewModel.Labels.PageRotateRight, Mode=OneWay}" Click="OnRibbonRotateRightClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionMoveUpMenuItem" Text="{x:Bind ViewModel.Labels.PageMoveUp, Mode=OneWay}" Click="OnThumbnailMoveUpClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionMoveDownMenuItem" Text="{x:Bind ViewModel.Labels.PageMoveDown, Mode=OneWay}" Click="OnThumbnailMoveDownClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE74B;" FontFamily="Segoe Fluent Icons" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionDeleteMenuItem" Text="{x:Bind ViewModel.Labels.PageDelete, Mode=OneWay}" Click="OnThumbnailDeleteClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE107;" FontFamily="Segoe Fluent Icons" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Content="{x:Bind ViewModel.Labels.Annotate, Mode=OneWay}"
                AutomationProperties.AutomationId="TopNavAnnotateButton"
                Style="{StaticResource TopNavButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateSelectMenuItem" Text="{x:Bind ViewModel.Labels.Select, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Select" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateHighlightMenuItem" Text="{x:Bind ViewModel.Labels.Highlight, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Highlight" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateInkMenuItem" Text="{x:Bind ViewModel.Labels.Ink, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Ink" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateTextMenuItem" Text="{x:Bind ViewModel.Labels.Text, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Text" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateNoteMenuItem" Text="{x:Bind ViewModel.Labels.Note, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Note" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateRectangleMenuItem" Text="{x:Bind ViewModel.Labels.Rectangle, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Rectangle" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateSignatureMenuItem" Text="{x:Bind ViewModel.Labels.Signature, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Signature" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateStampMenuItem" Text="{x:Bind ViewModel.Labels.Stamp, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Stamp" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotatePanelMenuItem" Text="{x:Bind ViewModel.Labels.Annotations, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleAnnotationsPanelCommand, Mode=OneWay}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Content="{x:Bind ViewModel.Labels.RibbonHelp, Mode=OneWay}"
                AutomationProperties.AutomationId="TopNavHelpButton"
                Style="{StaticResource TopNavButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem AutomationProperties.AutomationId="HelpSettingsMenuItem" Text="{x:Bind ViewModel.Labels.Settings, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSettingsPanelCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="HelpInfoMenuItem" Text="{x:Bind ViewModel.Labels.Info, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleInfoPanelCommand, Mode=OneWay}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2"
            Margin="8,6,8,6"
            Background="{ThemeResource RibbonBrush}"
            BorderBrush="{ThemeResource RibbonBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Translation="0,0,32">
      <Border.Shadow>
        <ThemeShadow />
      </Border.Shadow>
      <Grid Padding="16,8,16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Border Style="{StaticResource RibbonPillBorderStyle}">
              <StackPanel Orientation="Horizontal" Spacing="0">
                <Button Style="{StaticResource RibbonPillButtonStyle}"
                        Command="{x:Bind ViewModel.OpenCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Open, Mode=OneWay}"
                        AutomationProperties.AutomationId="RibbonOpenButton"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Open, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE838;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.Labels.Open, Mode=OneWay}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Style="{StaticResource RibbonPillButtonStyle}"
                        Command="{x:Bind ViewModel.MergeCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Merge, Mode=OneWay}"
                        AutomationProperties.AutomationId="RibbonMergeButton"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Merge, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.Labels.Merge, Mode=OneWay}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource RibbonPillBorderStyle}">
              <Button Style="{StaticResource RibbonPillButtonStyle}"
                      Command="{x:Bind ViewModel.PrintCommand, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Print, Mode=OneWay}"
                      AutomationProperties.AutomationId="RibbonPrintButton"
                      AutomationProperties.Name="{x:Bind ViewModel.Labels.Print, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE749;" FontFamily="Segoe Fluent Icons" FontSize="16" />
                  <TextBlock Text="{x:Bind ViewModel.Labels.Print, Mode=OneWay}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Border>
          </StackPanel>

          <TextBlock Text="{x:Bind ViewModel.Labels.RibbonFileGroup, Mode=OneWay}"
                     Style="{StaticResource RibbonLabelStyle}" />
        </StackPanel>

        <Rectangle Grid.Column="1" Style="{StaticResource RibbonSeparatorStyle}" />

        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Style="{StaticResource RibbonIconButtonStyle}"
                    Command="{x:Bind ViewModel.PreviousPageCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.PreviousPage, Mode=OneWay}"
                    AutomationProperties.AutomationId="RibbonPreviousPageButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.PreviousPage, Mode=OneWay}">
              <FontIcon Glyph="&#xE76B;" FontFamily="Segoe Fluent Icons" />
            </Button>

            <Border Height="40"
                    MinWidth="74"
                    Padding="14,0"
                    Background="{ThemeResource InputBrush}"
                    BorderBrush="{ThemeResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
              <TextBlock Text="{x:Bind ViewModel.ActiveDocumentTab.PageText, Mode=OneWay}"
                         Foreground="{ThemeResource TextPrimaryBrush}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center" />
            </Border>

            <Button Style="{StaticResource RibbonIconButtonStyle}"
                    Command="{x:Bind ViewModel.NextPageCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.NextPage, Mode=OneWay}"
                    AutomationProperties.AutomationId="RibbonNextPageButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.NextPage, Mode=OneWay}">
              <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" />
            </Button>

            <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" />

            <Button Style="{StaticResource RibbonIconButtonStyle}"
                    Click="OnRibbonRotateLeftClick"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.PageRotateLeft, Mode=OneWay}"
                    AutomationProperties.AutomationId="RibbonRotateLeftButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.PageRotateLeft, Mode=OneWay}">
              <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform>
                  <ScaleTransform ScaleX="-1" />
                </FontIcon.RenderTransform>
              </FontIcon>
            </Button>

            <Button Style="{StaticResource RibbonIconButtonStyle}"
                    Click="OnRibbonRotateRightClick"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.PageRotateRight, Mode=OneWay}"
                    AutomationProperties.AutomationId="RibbonRotateRightButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.PageRotateRight, Mode=OneWay}">
              <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" />
            </Button>
          </StackPanel>

          <TextBlock Text="{x:Bind ViewModel.Labels.RibbonNavigation, Mode=OneWay}"
                     Style="{StaticResource RibbonLabelStyle}" />
        </StackPanel>

        <Rectangle Grid.Column="3" Style="{StaticResource RibbonSeparatorStyle}" />

        <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Style="{StaticResource RibbonIconButtonStyle}"
                    Command="{x:Bind ViewModel.ZoomOutCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.ZoomOut, Mode=OneWay}"
                    AutomationProperties.AutomationId="RibbonZoomOutButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.ZoomOut, Mode=OneWay}">
              <FontIcon Glyph="&#xE738;" FontFamily="Segoe Fluent Icons" FontSize="16" />
            </Button>

            <Button Height="40"
                    AutomationProperties.AutomationId="RibbonZoomMenuButton"
                    MinWidth="92"
                    Padding="14,0"
                    Background="{ThemeResource InputBrush}"
                    BorderBrush="{ThemeResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem AutomationProperties.AutomationId="Zoom50MenuItem" Text="50%" Command="{x:Bind ViewModel.SetZoomCommand, Mode=OneWay}" CommandParameter="0.5" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="Zoom75MenuItem" Text="75%" Command="{x:Bind ViewModel.SetZoomCommand, Mode=OneWay}" CommandParameter="0.75" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="Zoom100MenuItem" Text="100%" Command="{x:Bind ViewModel.SetZoomCommand, Mode=OneWay}" CommandParameter="1.0" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="Zoom125MenuItem" Text="125%" Command="{x:Bind ViewModel.SetZoomCommand, Mode=OneWay}" CommandParameter="1.25" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="Zoom135MenuItem" Text="135%" Command="{x:Bind ViewModel.SetZoomCommand, Mode=OneWay}" CommandParameter="1.35" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="Zoom150MenuItem" Text="150%" Command="{x:Bind ViewModel.SetZoomCommand, Mode=OneWay}" CommandParameter="1.5" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="Zoom200MenuItem" Text="200%" Command="{x:Bind ViewModel.SetZoomCommand, Mode=OneWay}" CommandParameter="2.0" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="Zoom300MenuItem" Text="300%" Command="{x:Bind ViewModel.SetZoomCommand, Mode=OneWay}" CommandParameter="3.0" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem AutomationProperties.AutomationId="ZoomFitMenuItem" Text="{x:Bind ViewModel.Labels.ZoomFit, Mode=OneWay}" Command="{x:Bind ViewModel.FitPageCommand, Mode=OneWay}" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="ZoomActualMenuItem" Text="{x:Bind ViewModel.Labels.ZoomActual, Mode=OneWay}" Command="{x:Bind ViewModel.ActualSizeCommand, Mode=OneWay}" />
                </MenuFlyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.ActiveDocumentTab.ZoomText, Mode=OneWay}" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE70D;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="10"
                          Foreground="{ThemeResource TextSecondaryBrush}" />
              </StackPanel>
            </Button>

            <Button Style="{StaticResource RibbonIconButtonStyle}"
                    Command="{x:Bind ViewModel.ZoomInCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.ZoomIn, Mode=OneWay}"
                    AutomationProperties.AutomationId="RibbonZoomInButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.ZoomIn, Mode=OneWay}">
              <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="16" />
            </Button>

            <Button Style="{StaticResource RibbonTextButtonStyle}"
                    Command="{x:Bind ViewModel.FitPageCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.ZoomFit, Mode=OneWay}"
                    AutomationProperties.AutomationId="RibbonFitPageButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.ZoomFit, Mode=OneWay}">
              <StackPanel Spacing="2">
                <FontIcon Glyph="&#xE9A6;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="16"
                          HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.Labels.ZoomFit, Mode=OneWay}"
                           FontSize="12"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Style="{StaticResource RibbonTextButtonStyle}"
                    Command="{x:Bind ViewModel.ActualSizeCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.ZoomActual, Mode=OneWay}"
                    AutomationProperties.AutomationId="RibbonActualSizeButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.ZoomActual, Mode=OneWay}">
              <StackPanel Spacing="2">
                <FontIcon Glyph="&#xE740;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="16"
                          HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.Labels.ZoomActual, Mode=OneWay}" FontSize="12" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Text="{x:Bind ViewModel.Labels.RibbonZoom, Mode=OneWay}"
                     Style="{StaticResource RibbonLabelStyle}" />
        </StackPanel>

        <Rectangle Grid.Column="5" Style="{StaticResource RibbonSeparatorStyle}" />

        <Grid Grid.Column="6"
              Margin="24,0"
              VerticalAlignment="Center"
              HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border x:Name="SearchBoxBorder"
                  Grid.Row="0"
                  Height="40"
                  MinWidth="200"
                  MaxWidth="1200"
                  HorizontalAlignment="Stretch"
                  Background="{ThemeResource SearchBrush}"
                  BorderBrush="{ThemeResource InputBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <FontIcon Glyph="&#xE721;"
                        FontFamily="Segoe Fluent Icons"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center" />

              <TextBox Grid.Column="1"
                       AutomationProperties.AutomationId="RibbonSearchTextBox"
                       Background="Transparent"
                       BorderThickness="0"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       PlaceholderText="{x:Bind ViewModel.Labels.SearchPlaceholder, Mode=OneWay}"
                       Text="{x:Bind ViewModel.ActiveDocumentTab.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       KeyDown="OnSearchBoxKeyDown" />

              <TextBlock Grid.Column="2"
                         Text="Ctrl+F"
                         Foreground="{ThemeResource TextSecondaryBrush}"
                         FontSize="11"
                         Margin="8,0,12,0"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="1"
                     Text="{x:Bind ViewModel.Labels.Search, Mode=OneWay}"
                     Style="{StaticResource RibbonLabelStyle}" />
        </Grid>

        <Rectangle Grid.Column="7" Style="{StaticResource RibbonSeparatorStyle}" />

        <StackPanel Grid.Column="8" Spacing="6" VerticalAlignment="Center">
          <Border Style="{StaticResource RibbonPillBorderStyle}">
            <StackPanel Orientation="Horizontal" Spacing="0">
              <Button Style="{StaticResource RibbonPillIconButtonStyle}"
                      Command="{x:Bind ViewModel.TogglePagesPanelCommand, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Pages, Mode=OneWay}"
                      AutomationProperties.AutomationId="RibbonPagesPanelButton"
                      AutomationProperties.Name="{x:Bind ViewModel.Labels.Pages, Mode=OneWay}">
                <FontIcon Glyph="&#xE8FE;" FontFamily="Segoe Fluent Icons" />
              </Button>

              <Button Style="{StaticResource RibbonPillIconButtonStyle}"
                      Command="{x:Bind ViewModel.ToggleInfoPanelCommand, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Info, Mode=OneWay}"
                      AutomationProperties.AutomationId="RibbonInfoPanelButton"
                      AutomationProperties.Name="{x:Bind ViewModel.Labels.Info, Mode=OneWay}">
                <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" />
              </Button>
            </StackPanel>
          </Border>

          <TextBlock Text="{x:Bind ViewModel.Labels.RibbonDisplay, Mode=OneWay}"
                     Style="{StaticResource RibbonLabelStyle}" />
        </StackPanel>

        <Rectangle Grid.Column="9" Style="{StaticResource RibbonSeparatorStyle}" />

        <StackPanel Grid.Column="10" Spacing="6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Border Style="{StaticResource RibbonPillBorderStyle}">
              <StackPanel Orientation="Horizontal" Spacing="0">
                <Button x:Name="AnnotateBtnSelect"
                        AutomationProperties.AutomationId="RibbonAnnotationSelectButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Background="{x:Bind services:XamlBindingHelpers.AnnotationToolBackground(ViewModel.ActiveDocumentTab.SelectedAnnotationTool, 'Select'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Select"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Select, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Select, Mode=OneWay}">
                  <FontIcon Glyph="&#xE8B3;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnHighlight"
                        AutomationProperties.AutomationId="RibbonAnnotationHighlightButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Background="{x:Bind services:XamlBindingHelpers.AnnotationToolBackground(ViewModel.ActiveDocumentTab.SelectedAnnotationTool, 'Highlight'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Highlight"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Highlight, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Highlight, Mode=OneWay}">
                  <FontIcon Glyph="&#xE891;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnText"
                        AutomationProperties.AutomationId="RibbonAnnotationTextButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Background="{x:Bind services:XamlBindingHelpers.AnnotationToolBackground(ViewModel.ActiveDocumentTab.SelectedAnnotationTool, 'Text'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Text"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Text, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Text, Mode=OneWay}">
                  <FontIcon Glyph="&#xE8D2;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnNote"
                        AutomationProperties.AutomationId="RibbonAnnotationNoteButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Background="{x:Bind services:XamlBindingHelpers.AnnotationToolBackground(ViewModel.ActiveDocumentTab.SelectedAnnotationTool, 'Note'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Note"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Note, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Note, Mode=OneWay}">
                  <FontIcon Glyph="&#xE90A;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnStamp"
                        AutomationProperties.AutomationId="RibbonAnnotationStampButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Visibility="Collapsed"
                        Background="{x:Bind services:XamlBindingHelpers.AnnotationToolBackground(ViewModel.ActiveDocumentTab.SelectedAnnotationTool, 'Stamp'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Stamp"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Stamp, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Stamp, Mode=OneWay}">
                  <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnInk"
                        AutomationProperties.AutomationId="RibbonAnnotationInkButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Visibility="Collapsed"
                        Background="{x:Bind services:XamlBindingHelpers.AnnotationToolBackground(ViewModel.ActiveDocumentTab.SelectedAnnotationTool, 'Ink'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Ink"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Ink, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Ink, Mode=OneWay}">
                  <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnErase"
                        AutomationProperties.AutomationId="RibbonAnnotationEraseButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Visibility="Collapsed"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Erase"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Erase, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Erase, Mode=OneWay}">
                  <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnPanel"
                        AutomationProperties.AutomationId="RibbonAnnotationsPanelButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleAnnotationsPanelCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Annotations, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Annotations, Mode=OneWay}">
                  <FontIcon Glyph="&#xE924;" FontFamily="Segoe Fluent Icons" />
                </Button>
              </StackPanel>
            </Border>

            <Button Style="{StaticResource RibbonIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Settings, Mode=OneWay}"
                    AutomationProperties.AutomationId="RibbonSettingsMenuButton"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.Settings, Mode=OneWay}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="{x:Bind ViewModel.Labels.Settings, Mode=OneWay}"
                                  AutomationProperties.AutomationId="RibbonSettingsMenuItem"
                                  Command="{x:Bind ViewModel.ToggleSettingsPanelCommand, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </Button.Flyout>
              <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons" />
            </Button>
          </StackPanel>

          <TextBlock Text="{x:Bind ViewModel.Labels.RibbonAnnotateGroup, Mode=OneWay}"
                     Style="{StaticResource RibbonLabelStyle}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="8,0,8,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <controls:PagesPanelControl Grid.Column="0" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

      <Border Grid.Column="1"
              Width="8"
              Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsPagesPanelVisible), Mode=OneWay, FallbackValue=Collapsed}" />

      <Border Grid.Column="2"
              Background="{ThemeResource ViewerBackgroundBrush}"
              BorderBrush="{ThemeResource PanelLineBrush}"
              BorderThickness="1"
              CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid>
          <Grid.ChildrenTransitions>
            <EntranceThemeTransition />
          </Grid.ChildrenTransitions>
          <ScrollViewer x:Name="DocumentScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        ZoomMode="Enabled"
                        SizeChanged="OnDocumentScrollViewerSizeChanged">
            <Grid MinHeight="840"
                  Padding="40,16,40,24"
                  DataContext="{x:Bind ViewModel.ActiveDocumentTab, Mode=OneWay}">
              <Grid HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Width="{x:Bind ViewModel.ActiveDocumentTab.CommentLaneWidth, Mode=OneWay}"
                      Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                      Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasCurrentPageComments), Mode=OneWay}">
                  <ItemsControl AutomationProperties.AutomationId="CurrentPageCommentOverlayItems"
                                ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.CurrentPageCommentOverlays, Mode=OneWay}"
                                Width="280"
                                Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WindowsCommentOverlayViewModel">
                        <Grid Width="{x:Bind LaneWidth, Mode=OneWay}"
                              MinHeight="78"
                              Margin="{x:Bind services:XamlBindingHelpers.CreateThickness(0, Top, 0, 0), Mode=OneWay}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                          </Grid.ColumnDefinitions>

                          <Border Background="{ThemeResource CardBrush}"
                                  AutomationProperties.AutomationId="{x:Bind CardAutomationId, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind Text, Mode=OneWay}"
                                  IsTabStop="True"
                                  BorderBrush="{ThemeResource CardBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{ThemeResource OverlayCornerRadius}"
                                  Padding="12,10"
                                  KeyDown="OnCommentCardKeyDown"
                                  DoubleTapped="OnCommentCardDoubleTapped">
                            <StackPanel Spacing="6">
                              <Grid>
                                <TextBlock Text="{x:Bind PageLabel, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right" />
                              </Grid>
                              <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                         Foreground="{ThemeResource TextPrimaryBrush}"
                                         FontSize="13"
                                         TextWrapping="Wrap"
                                         MaxLines="4"
                                         Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsReadVisible), Mode=OneWay}" />
                              <TextBox AutomationProperties.AutomationId="CommentOverlayEditTextBox"
                                       Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       AcceptsReturn="True"
                                       MinHeight="40"
                                       Padding="6,4"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsEditVisible), Mode=OneWay}"
                                       LostFocus="OnCommentEditLostFocus"
                                       KeyDown="OnCommentEditKeyDown" />
                            </StackPanel>
                          </Border>

                          <Grid Grid.Column="1"
                                Height="28"
                                Margin="0,18,0,0"
                                VerticalAlignment="Top">
                            <Rectangle Height="1"
                                       Fill="{x:Bind services:XamlBindingHelpers.BrushFromHex(StrokeHex, StrokeAlpha), Mode=OneWay}"
                                       VerticalAlignment="Center" />
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{x:Bind services:XamlBindingHelpers.BrushFromHex(StrokeHex, StrokeAlpha), Mode=OneWay}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <Border Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="{ThemeResource PaperBrush}"
                      BorderBrush="{ThemeResource PaperBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid x:Name="DocumentPageLayer"
                      AutomationProperties.AutomationId="DocumentPageLayer"
                      Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                      Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                      Background="Transparent"
                      PointerPressed="OnDocumentLayerPointerPressed"
                      PointerMoved="OnDocumentLayerPointerMoved"
                      PointerReleased="OnDocumentLayerPointerReleased"
                      PointerCanceled="OnDocumentLayerPointerCanceled"
                      RightTapped="OnDocumentLayerRightTapped">
                  <Grid.ContextFlyout>
                    <MenuFlyout x:Name="AnnotationContextMenu">
                      <MenuFlyoutItem x:Name="ContextMenuDeleteItem" AutomationProperties.AutomationId="AnnotationContextDeleteMenuItem" Click="OnContextMenuDelete">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                          <KeyboardAccelerator Key="Delete" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator />
                      <MenuFlyoutItem x:Name="ContextMenuRotate90Item" AutomationProperties.AutomationId="AnnotationContextRotate90MenuItem" Click="OnContextMenuRotate90">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextMenuResetRotationItem" AutomationProperties.AutomationId="AnnotationContextResetRotationMenuItem" Click="OnContextMenuResetRotation">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator />
                      <MenuFlyoutItem x:Name="ContextMenuFlipHItem" AutomationProperties.AutomationId="AnnotationContextFlipHorizontalMenuItem" Click="OnContextMenuFlipH">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xEA4F;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextMenuFlipVItem" AutomationProperties.AutomationId="AnnotationContextFlipVerticalMenuItem" Click="OnContextMenuFlipV">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xEA4E;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </Grid.ContextFlyout>
                  <Image Source="{x:Bind ViewModel.ActiveDocumentTab.CurrentPageImage, Mode=OneWay}"
                         Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                         Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                         Stretch="None"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top" />

                  <ItemsControl AutomationProperties.AutomationId="CurrentPageAnnotationOverlayItems"
                                ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.CurrentPageAnnotationOverlays, Mode=OneWay}"
                                Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Grid />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WindowsAnnotationOverlayViewModel">
                        <Canvas Width="{x:Bind Width, Mode=OneWay}"
                                Height="{x:Bind Height, Mode=OneWay}"
                                Margin="{x:Bind services:XamlBindingHelpers.CreateThickness(Left, Top, 0, 0), Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Opacity="{x:Bind Opacity, Mode=OneWay}"
                                Visibility="{x:Bind services:XamlBindingHelpers.InverseBoolToVisibility(IsHidden), Mode=OneWay}">
                          <!-- Rotatable annotation content + selection -->
                          <Canvas Width="{x:Bind Width, Mode=OneWay}"
                                  Height="{x:Bind Height, Mode=OneWay}">
                            <Canvas.RenderTransform>
                              <RotateTransform Angle="{x:Bind RotationAngle, Mode=OneWay}"
                                               CenterX="{x:Bind RotationCenterX, Mode=OneWay}"
                                               CenterY="{x:Bind RotationCenterY, Mode=OneWay}" />
                            </Canvas.RenderTransform>
                            <Border Width="{x:Bind Width, Mode=OneWay}"
                                    Height="{x:Bind Height, Mode=OneWay}"
                                    Background="{x:Bind services:XamlBindingHelpers.BrushFromHex(FillHex, FillAlpha), Mode=OneWay}"
                                    BorderBrush="{x:Bind services:XamlBindingHelpers.BrushFromHex(StrokeHex, StrokeAlpha), Mode=OneWay}"
                                    BorderThickness="{x:Bind services:XamlBindingHelpers.CreateUniformThickness(BorderThicknessValue), Mode=OneWay}"
                                    CornerRadius="{x:Bind services:XamlBindingHelpers.CreateCornerRadius(CornerRadiusValue), Mode=OneWay}"
                                    Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsBoxVisible), Mode=OneWay}" />
                            <Polyline Points="{x:Bind services:XamlBindingHelpers.PointCollectionFromOverlayPoints(InkPoints), Mode=OneWay}"
                                      Stroke="{x:Bind services:XamlBindingHelpers.BrushFromHex(StrokeHex, StrokeAlpha), Mode=OneWay}"
                                      StrokeThickness="{x:Bind StrokeThickness, Mode=OneWay}"
                                      Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsInkVisible), Mode=OneWay}" />
                            <Image Width="{x:Bind Width, Mode=OneWay}"
                                   Height="{x:Bind Height, Mode=OneWay}"
                                   Source="{x:Bind services:XamlBindingHelpers.ImageSourceFromPath(SignatureImagePath), Mode=OneWay}"
                                   Stretch="Uniform"
                                   Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSignatureImageVisible), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                       Foreground="{x:Bind services:XamlBindingHelpers.BrushFromHex(TextHex, TextAlpha), Mode=OneWay}"
                                       FontSize="{x:Bind TextFontSize, Mode=OneWay}"
                                       FontFamily="{x:Bind TextFontFamily, Mode=OneWay}"
                                       FontWeight="{x:Bind services:XamlBindingHelpers.TextFontWeight(TextIsBold), Mode=OneWay}"
                                       FontStyle="{x:Bind services:XamlBindingHelpers.TextFontStyle(TextIsItalic), Mode=OneWay}"
                                       TextAlignment="{x:Bind services:XamlBindingHelpers.TextAlignmentFromAnnotation(TextAlignment), Mode=OneWay}"
                                       Width="{x:Bind Width, Mode=OneWay}"
                                       Height="{x:Bind Height, Mode=OneWay}"
                                       Padding="8,4"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsTextVisible), Mode=OneWay}" />
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                      FontFamily="Segoe Fluent Icons"
                                      Foreground="{x:Bind services:XamlBindingHelpers.BrushFromHex(TextHex, TextAlpha), Mode=OneWay}"
                                      FontSize="16"
                                      Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsGlyphVisible), Mode=OneWay}" />
                            <!-- Selection box + rotate button (all rotate with content) -->
                            <Canvas Width="{x:Bind SelectionWidth, Mode=OneWay}"
                                    Height="{x:Bind SelectionHeight, Mode=OneWay}"
                                    Margin="{x:Bind services:XamlBindingHelpers.CreateThickness(SelectionOffsetLeft, SelectionOffsetTop, 0, 0), Mode=OneWay}"
                                    Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}">
                              <Rectangle Width="{x:Bind SelectionWidth, Mode=OneWay}"
                                         Height="{x:Bind SelectionHeight, Mode=OneWay}"
                                         Stroke="{ThemeResource AccentBrush}"
                                         StrokeThickness="{x:Bind SelectionStrokeThickness, Mode=OneWay}"
                                         StrokeDashArray="2,2"
                                         Fill="Transparent" />
                              <Ellipse Width="{x:Bind SelectionHandleSize, Mode=OneWay}"
                                       Height="{x:Bind SelectionHandleSize, Mode=OneWay}"
                                       Canvas.Left="{x:Bind SelectionHandleOffset, Mode=OneWay}"
                                       Canvas.Top="{x:Bind SelectionHandleOffset, Mode=OneWay}"
                                       Fill="{ThemeResource AccentBrush}" />
                              <Ellipse Width="{x:Bind SelectionHandleSize, Mode=OneWay}"
                                       Height="{x:Bind SelectionHandleSize, Mode=OneWay}"
                                       Canvas.Left="{x:Bind SelectionHandleOffset, Mode=OneWay}"
                                       Canvas.Top="{x:Bind services:XamlBindingHelpers.Subtract(SelectionHeight, SelectionHandleHalfSize), Mode=OneWay}"
                                       Fill="{ThemeResource AccentBrush}" />
                              <Ellipse Width="{x:Bind SelectionHandleSize, Mode=OneWay}"
                                       Height="{x:Bind SelectionHandleSize, Mode=OneWay}"
                                       Canvas.Top="{x:Bind SelectionHandleOffset, Mode=OneWay}"
                                       Canvas.Left="{x:Bind services:XamlBindingHelpers.Subtract(SelectionWidth, SelectionHandleHalfSize), Mode=OneWay}"
                                       Fill="{ThemeResource AccentBrush}" />
                              <Ellipse Width="{x:Bind SelectionHandleSize, Mode=OneWay}"
                                       Height="{x:Bind SelectionHandleSize, Mode=OneWay}"
                                       Canvas.Left="{x:Bind services:XamlBindingHelpers.Subtract(SelectionWidth, SelectionHandleHalfSize), Mode=OneWay}"
                                       Canvas.Top="{x:Bind services:XamlBindingHelpers.Subtract(SelectionHeight, SelectionHandleHalfSize), Mode=OneWay}"
                                       Fill="{ThemeResource AccentBrush}" />
                              <!-- Rotation stem line -->
                              <Line X1="0" Y1="0" X2="0" Y2="{x:Bind RotateStemY2, Mode=OneWay}"
                                    Stroke="{ThemeResource AccentBrush}"
                                    StrokeThickness="1.5"
                                    Canvas.Top="{x:Bind RotateStemTop, Mode=OneWay}"
                                    Canvas.Left="{x:Bind RotateStemLeft, Mode=OneWay}" />
                              <Grid Width="20" Height="20"
                                      Canvas.Left="{x:Bind RotateButtonLeft, Mode=OneWay}"
                                      Canvas.Top="{x:Bind RotateButtonTop, Mode=OneWay}">
                                <Ellipse Fill="{ThemeResource AccentBrush}" />
                                <FontIcon Glyph="&#xE7AD;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Grid>
                            </Canvas>
                          </Canvas>
                        </Canvas>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Grid Width="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.Width, Mode=OneWay, FallbackValue=180}"
                        Height="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.Height, Mode=OneWay, FallbackValue=72}"
                        Margin="{x:Bind services:XamlBindingHelpers.InlineTextEditorMargin(ViewModel.ActiveDocumentTab.InlineTextEditor), Mode=OneWay}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Canvas.ZIndex="20"
                        Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasInlineTextEditor), Mode=OneWay}">
                    <Border Background="{x:Bind services:XamlBindingHelpers.InlineTextEditorFillBrush(ViewModel.ActiveDocumentTab.InlineTextEditor), Mode=OneWay}"
                            BorderBrush="{ThemeResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="2" />
                    <TextBox x:Name="InlineTextEditorBox"
                             AutomationProperties.AutomationId="InlineTextEditorTextBox"
                             Padding="8,4"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             BorderThickness="0"
                             CornerRadius="0"
                             Foreground="{x:Bind services:XamlBindingHelpers.InlineTextEditorStrokeBrush(ViewModel.ActiveDocumentTab.InlineTextEditor), Mode=OneWay}"
                             FontSize="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.FontSize, Mode=OneWay, FallbackValue=14}"
                             FontFamily="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.FontFamily, Mode=OneWay, FallbackValue='Segoe UI'}"
                             FontWeight="{x:Bind services:XamlBindingHelpers.TextFontWeight(ViewModel.ActiveDocumentTab.InlineTextEditor.TextIsBold), Mode=OneWay}"
                             FontStyle="{x:Bind services:XamlBindingHelpers.TextFontStyle(ViewModel.ActiveDocumentTab.InlineTextEditor.TextIsItalic), Mode=OneWay}"
                             TextAlignment="{x:Bind services:XamlBindingHelpers.TextAlignmentFromAnnotation(ViewModel.ActiveDocumentTab.InlineTextEditor.TextAlignment), Mode=OneWay}"
                             PlaceholderText="{x:Bind ViewModel.Labels.AnnotationTextPlaceholder, Mode=OneWay}"
                             PlaceholderForeground="{x:Bind services:XamlBindingHelpers.InlineTextEditorStrokeBrush(ViewModel.ActiveDocumentTab.InlineTextEditor), Mode=OneWay}"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.Text, Mode=OneWay}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             TextChanged="OnInlineTextEditorTextChanged"
                             LostFocus="OnInlineTextEditorLostFocus"
                             KeyDown="OnInlineTextEditorKeyDown">
                      <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlForeground" Color="#111827" />
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#111827" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#111827" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#111827" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#111827" />
                      </TextBox.Resources>
                    </TextBox>
                    <Canvas IsHitTestVisible="False">
                      <Ellipse Width="8" Height="8"
                               Canvas.Left="-4"
                               Canvas.Top="-4"
                               Fill="{ThemeResource AccentBrush}" />
                      <Ellipse Width="8" Height="8"
                               Canvas.Left="-4"
                               Canvas.Top="{x:Bind services:XamlBindingHelpers.Subtract(ViewModel.ActiveDocumentTab.InlineTextEditor.Height, 4), Mode=OneWay}"
                               Fill="{ThemeResource AccentBrush}" />
                      <Ellipse Width="8" Height="8"
                               Canvas.Left="{x:Bind services:XamlBindingHelpers.Subtract(ViewModel.ActiveDocumentTab.InlineTextEditor.Width, 4), Mode=OneWay}"
                               Canvas.Top="-4"
                               Fill="{ThemeResource AccentBrush}" />
                      <Ellipse Width="8" Height="8"
                               Canvas.Left="{x:Bind services:XamlBindingHelpers.Subtract(ViewModel.ActiveDocumentTab.InlineTextEditor.Width, 4), Mode=OneWay}"
                               Canvas.Top="{x:Bind services:XamlBindingHelpers.Subtract(ViewModel.ActiveDocumentTab.InlineTextEditor.Height, 4), Mode=OneWay}"
                               Fill="{ThemeResource AccentBrush}" />
                      <Line X1="0"
                            Y1="0"
                            X2="0"
                            Y2="12"
                            Canvas.Left="{x:Bind services:XamlBindingHelpers.CenterOffset(ViewModel.ActiveDocumentTab.InlineTextEditor.Width, 0), Mode=OneWay}"
                            Canvas.Top="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.Height, Mode=OneWay}"
                            Stroke="{ThemeResource AccentBrush}"
                            StrokeThickness="1.5" />
                      <Ellipse Width="16"
                               Height="16"
                               Canvas.Left="{x:Bind services:XamlBindingHelpers.CenterOffset(ViewModel.ActiveDocumentTab.InlineTextEditor.Width, 16), Mode=OneWay}"
                               Canvas.Top="{x:Bind services:XamlBindingHelpers.Add(ViewModel.ActiveDocumentTab.InlineTextEditor.Height, 12), Mode=OneWay}"
                               Fill="White"
                               Stroke="{ThemeResource AccentBrush}"
                               StrokeThickness="2" />
                    </Canvas>
                  </Grid>

                  <controls:TextAnnotationFloatingToolbar
                      x:Name="TextAnnotationToolbar"
                      ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                      Margin="{x:Bind ViewModel.ActiveDocumentTab.TextAnnotationToolbarMargin, Mode=OneWay}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Canvas.ZIndex="30"
                      Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsTextToolbarVisible), Mode=OneWay}" />

                  <ItemsControl AutomationProperties.AutomationId="SearchHighlightOverlayItems"
                                ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.SearchHighlights, Mode=OneWay}"
                                Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasSearchHighlights), Mode=OneWay}"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Grid />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TextSelectionHighlightItem">
                        <Border Width="{x:Bind Width, Mode=OneWay}"
                                Height="{x:Bind Height, Mode=OneWay}"
                                Margin="{x:Bind Margin, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource SearchHighlightBrush}"
                                Opacity="0.34" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl AutomationProperties.AutomationId="TextSelectionHighlightOverlayItems"
                                ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.TextSelectionHighlights, Mode=OneWay}"
                                Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasTextSelectionHighlights), Mode=OneWay}"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Grid />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TextSelectionHighlightItem">
                        <Border Width="{x:Bind Width, Mode=OneWay}"
                                Height="{x:Bind Height, Mode=OneWay}"
                                Margin="{x:Bind Margin, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentBrush}"
                                Opacity="0.28" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Column="3"
            HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="8,0,0,0"
            Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.IsAnyRightPanelOpen), Mode=OneWay}">
        <Grid.TranslationTransition>
          <Vector3Transition Duration="0:0:0.2" />
        </Grid.TranslationTransition>
        <controls:AnnotationPanelControl x:Name="AnnotationsPanelControl"
                                         ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                         AnnotationTextDraftSubmitted="OnAnnotationTextDraftSubmitted" />

        <controls:SettingsPanelControl ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

        <controls:InfoPanelControl ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

        <controls:SearchPanelControl ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

      </Grid>
    </Grid>

    <controls:WorkspaceStatusBar Grid.Row="4"
                                 ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

  </Grid>
</Window>
