            <Button Style="{StaticResource RibbonTextButtonStyle}"
                    Command="{x:Bind ViewModel.FitPageCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.ZoomFit, Mode=OneWay}"
