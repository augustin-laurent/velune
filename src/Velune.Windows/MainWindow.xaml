              <Button Style="{StaticResource RibbonPillIconButtonStyle}"
                      Command="{x:Bind ViewModel.ToggleInfoPanelCommand, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Info, Mode=OneWay}"
