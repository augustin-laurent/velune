                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Text, Mode=OneWay}">
                  <FontIcon Glyph="&#xE8D2;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnNote"
                        AutomationProperties.AutomationId="RibbonAnnotationNoteButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Background="{x:Bind services:XamlBindingHelpers.AnnotationToolBackground(ViewModel.ActiveDocumentTab.SelectedAnnotationTool, 'Note'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Note"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Note, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Note, Mode=OneWay}">
                  <FontIcon Glyph="&#xE90A;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnStamp"
                        AutomationProperties.AutomationId="RibbonAnnotationStampButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Visibility="Collapsed"
                        Background="{x:Bind services:XamlBindingHelpers.AnnotationToolBackground(ViewModel.ActiveDocumentTab.SelectedAnnotationTool, 'Stamp'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Stamp"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Stamp, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Stamp, Mode=OneWay}">
                  <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnInk"
                        AutomationProperties.AutomationId="RibbonAnnotationInkButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Visibility="Collapsed"
                        Background="{x:Bind services:XamlBindingHelpers.AnnotationToolBackground(ViewModel.ActiveDocumentTab.SelectedAnnotationTool, 'Ink'), Mode=OneWay}"
                        Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}"
                        CommandParameter="Ink"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Ink, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.Ink, Mode=OneWay}">
                  <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" />
                </Button>

                <Button x:Name="AnnotateBtnErase"
                        AutomationProperties.AutomationId="RibbonAnnotationEraseButton"
                        Style="{StaticResource RibbonPillIconButtonStyle}"
                        Visibility="Collapsed"
