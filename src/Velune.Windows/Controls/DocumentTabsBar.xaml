<UserControl
    x:Class="Velune.Windows.Controls.DocumentTabsBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Velune.Windows.Services"
    xmlns:vm="using:Velune.Windows.ViewModels">

  <StackPanel Orientation="Horizontal"
              Spacing="4">
    <ItemsControl AutomationProperties.AutomationId="DocumentTabsList"
                  ItemsSource="{Binding DocumentTabs, Mode=OneWay}"
                  Height="46"
                  VerticalAlignment="Bottom">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:WindowsDocumentTabViewModel">
          <Border Width="250"
                  Height="36"
                  Margin="2,0"
                  Background="{x:Bind services:XamlBindingHelpers.DocumentTabBackground(TabChromeState, IsLightTheme), Mode=OneWay}"
                  BorderBrush="{x:Bind services:XamlBindingHelpers.DocumentTabBorderBrush(TabChromeState, IsLightTheme), Mode=OneWay}"
                  BorderThickness="1"
                  CornerRadius="{ThemeResource OverlayCornerRadius}"
                  PointerEntered="OnTabPointerEntered"
                  PointerExited="OnTabPointerExited">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <FontIcon Glyph="&#xE8A5;"
                        FontFamily="Segoe Fluent Icons"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        FontSize="14"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Title, Mode=OneWay}"
                         Foreground="{ThemeResource TextPrimaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />

              <Button Grid.Column="0"
                      AutomationProperties.AutomationId="DocumentTabSelectButton"
                      Grid.ColumnSpan="2"
                      MinWidth="0"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Click="OnTabClicked" />

              <Button Grid.Column="2"
                      AutomationProperties.AutomationId="DocumentTabCloseButton"
                      Width="30"
                      Height="30"
                      Margin="4,0,8,0"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="OnCloseTabClicked"
                      ToolTipService.ToolTip="{x:Bind CloseTabLabel, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind CloseTabLabel, Mode=OneWay}"
                      VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8BB;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="10" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button Style="{StaticResource TitleBarIconButtonStyle}"
            Command="{Binding OpenCommand, Mode=OneWay}"
            ToolTipService.ToolTip="{Binding Labels.Open, Mode=OneWay}"
            AutomationProperties.AutomationId="TitleBarOpenButton"
            AutomationProperties.Name="{Binding Labels.Open, Mode=OneWay}">
      <FontIcon Glyph="&#xE710;"
                FontFamily="Segoe Fluent Icons"
                FontSize="16" />
    </Button>
  </StackPanel>
</UserControl>
