                      AutomationProperties.AutomationId="PagesPanelOrganizerButton"
                      Height="28"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      ToolTipService.ToolTip="Page Organizer"
                      Click="OnOpenPageOrganizerClicked">
                <FontIcon Glyph="&#xE8FD;"
                          FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource TextSecondaryBrush}"
                          FontSize="14" />
              </Button>
