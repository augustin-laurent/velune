                AutomationProperties.AutomationId="ThumbnailDragSurface"
                Grid.Row="1"
                Background="Transparent"
                AllowDrop="True"
                DragOver="OnThumbnailExternalDragOver"
                DragLeave="OnThumbnailExternalDragLeave"
                Drop="OnThumbnailExternalDrop">
            <ScrollViewer x:Name="ThumbnailScrollViewer"
                           VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsRepeater x:Name="ThumbnailListView"
                             AutomationProperties.AutomationId="PageThumbnailsList"
                             ElementPrepared="OnThumbnailElementPrepared"
                             ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.Thumbnails, Mode=OneWay}">
                <ItemsRepeater.Layout>
                  <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:WindowsPageThumbnailViewModel">
                    <Grid AutomationProperties.AutomationId="PageThumbnailItem"
                          Tag="{x:Bind PageNumber, Mode=OneWay}"
                          Height="172"
                          Padding="0,4"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Loaded="OnThumbnailItemLoaded"
                          PointerPressed="OnThumbnailItemPointerPressed"
                          PointerMoved="OnThumbnailItemPointerMoved"
                          PointerReleased="OnThumbnailItemPointerReleased"
                          PointerEntered="OnThumbnailPointerEntered"
                          PointerExited="OnThumbnailPointerExited"
                          RightTapped="OnThumbnailItemRightTapped">
                      <Grid.ContextFlyout>
                        <MenuFlyout>
                          <MenuFlyoutItem AutomationProperties.AutomationId="ThumbnailRotateLeftMenuItem" Text="{x:Bind PageRotateLeftLabel, Mode=OneWay}" Click="OnThumbnailRotateLeftClick">
                            <MenuFlyoutItem.Icon>
                              <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform>
                              </FontIcon>
                            </MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                          <MenuFlyoutItem AutomationProperties.AutomationId="ThumbnailRotateRightMenuItem" Text="{x:Bind PageRotateRightLabel, Mode=OneWay}" Click="OnThumbnailRotateRightClick">
                            <MenuFlyoutItem.Icon>
                              <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" />
                            </MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                          <MenuFlyoutSeparator />
                          <MenuFlyoutItem AutomationProperties.AutomationId="ThumbnailMoveUpMenuItem" Text="{x:Bind PageMoveUpLabel, Mode=OneWay}" Click="OnThumbnailMoveUpClick">
                            <MenuFlyoutItem.Icon>
                              <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" />
                            </MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                          <MenuFlyoutItem AutomationProperties.AutomationId="ThumbnailMoveDownMenuItem" Text="{x:Bind PageMoveDownLabel, Mode=OneWay}" Click="OnThumbnailMoveDownClick">
                            <MenuFlyoutItem.Icon>
                              <FontIcon Glyph="&#xE74B;" FontFamily="Segoe Fluent Icons" />
                            </MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                          <MenuFlyoutSeparator />
                          <MenuFlyoutItem AutomationProperties.AutomationId="ThumbnailDeleteMenuItem" Text="{x:Bind PageDeleteLabel, Mode=OneWay}" Click="OnThumbnailDeleteClick">
                            <MenuFlyoutItem.Icon>
                              <FontIcon Glyph="&#xE107;" FontFamily="Segoe Fluent Icons" />
                            </MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                        </MenuFlyout>
                      </Grid.ContextFlyout>
                      <Grid.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.2" />
                      </Grid.TranslationTransition>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Rectangle Grid.Column="0"
                                 Width="3"
                                 RadiusX="1.5"
                                 RadiusY="1.5"
                                 Fill="{ThemeResource AccentBrush}"
                                 VerticalAlignment="Stretch"
                                 Margin="0,8"
                                 Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                      <Rectangle x:Name="HoverBar"
                                 Grid.Column="0"
                                 Width="3"
                                 RadiusX="1.5"
                                 RadiusY="1.5"
                                 Fill="{ThemeResource AccentBrush}"
                                 VerticalAlignment="Stretch"
                                 Margin="0,8"
                                 Opacity="0" />

                      <StackPanel Grid.Column="1"
                                  Margin="4,0,0,0"
                                  HorizontalAlignment="Center"
                                  Spacing="4"
                                  IsHitTestVisible="False">
                        <Grid Width="110" Height="144">
                          <Image Source="{x:Bind Image, Mode=OneWay}"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                          <ProgressRing Width="24"
                                        Height="24"
                                        IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                        Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsLoading), Mode=OneWay}" />
                          <TextBlock Text="{x:Bind PlaceholderText, Mode=OneWay}"
                                     Foreground="{ThemeResource TextSecondaryBrush}"
                                     FontSize="11"
                                     TextAlignment="Center"
                                     TextWrapping="Wrap"
                                     MaxWidth="100"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(HasPlaceholder), Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind PageNumber, Mode=OneWay}"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </ScrollViewer>

            <!-- Drag ghost overlay -->
            <Image x:Name="ThumbnailDragGhost"
                   Width="80"
                   Height="104"
                   Stretch="Uniform"
                   Opacity="0.8"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Visibility="Collapsed" />

            <!-- Drop indicator line -->
            <Rectangle x:Name="ThumbnailDropIndicator"
                       Height="3"
                       RadiusX="1.5"
                       RadiusY="1.5"
                       Fill="{ThemeResource AccentBrush}"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"
                       Margin="8,0"
                       Visibility="Collapsed" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Width="8"
              Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsPagesPanelVisible), Mode=OneWay, FallbackValue=Collapsed}" />

      <Border Grid.Column="2"
              Background="{ThemeResource ViewerBackgroundBrush}"
              BorderBrush="{ThemeResource PanelLineBrush}"
              BorderThickness="1"
              CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid>
          <Grid.ChildrenTransitions>
            <EntranceThemeTransition />
          </Grid.ChildrenTransitions>
          <ScrollViewer x:Name="DocumentScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        ZoomMode="Enabled"
                        SizeChanged="OnDocumentScrollViewerSizeChanged">
            <Grid MinHeight="840"
                  Padding="40,16,40,24"
                  DataContext="{x:Bind ViewModel.ActiveDocumentTab, Mode=OneWay}">
              <Grid HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Width="{x:Bind ViewModel.ActiveDocumentTab.CommentLaneWidth, Mode=OneWay}"
                      Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                      Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasCurrentPageComments), Mode=OneWay}">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.CurrentPageCommentOverlays, Mode=OneWay}"
                                Width="280"
                                Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WindowsCommentOverlayViewModel">
                        <Grid Width="{x:Bind LaneWidth, Mode=OneWay}"
                              MinHeight="78"
                              Margin="{x:Bind Margin, Mode=OneWay}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                          </Grid.ColumnDefinitions>

                          <Border Background="{ThemeResource CardBrush}"
                                  AutomationProperties.AutomationId="CommentOverlayCard"
                                  BorderBrush="{ThemeResource CardBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{ThemeResource OverlayCornerRadius}"
                                  Padding="12,10"
                                  DoubleTapped="OnCommentCardDoubleTapped">
                            <StackPanel Spacing="6">
                              <Grid>
                                <TextBlock Text="{x:Bind PageLabel, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right" />
                              </Grid>
                              <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                         Foreground="{ThemeResource TextPrimaryBrush}"
                                         FontSize="13"
                                         TextWrapping="Wrap"
                                         MaxLines="4"
                                         Visibility="{x:Bind ReadVisibility, Mode=OneWay}" />
                              <TextBox AutomationProperties.AutomationId="CommentOverlayEditTextBox"
                                       Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       AcceptsReturn="True"
                                       MinHeight="40"
                                       Padding="6,4"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Visibility="{x:Bind EditVisibility, Mode=OneWay}"
                                       LostFocus="OnCommentEditLostFocus"
                                       KeyDown="OnCommentEditKeyDown" />
                            </StackPanel>
                          </Border>

                          <Grid Grid.Column="1"
                                Height="28"
                                Margin="0,18,0,0"
                                VerticalAlignment="Top">
                            <Rectangle Height="1"
                                       Fill="{x:Bind StrokeBrush, Mode=OneWay}"
                                       VerticalAlignment="Center" />
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{x:Bind StrokeBrush, Mode=OneWay}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <Border Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="{ThemeResource PaperBrush}"
                      BorderBrush="{ThemeResource PaperBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid x:Name="DocumentPageLayer"
                      AutomationProperties.AutomationId="DocumentPageLayer"
                      Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                      Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                      Background="Transparent"
                      PointerPressed="OnDocumentLayerPointerPressed"
                      PointerMoved="OnDocumentLayerPointerMoved"
                      PointerReleased="OnDocumentLayerPointerReleased"
                      PointerCanceled="OnDocumentLayerPointerCanceled"
                      RightTapped="OnDocumentLayerRightTapped">
                  <Grid.ContextFlyout>
                    <MenuFlyout x:Name="AnnotationContextMenu">
                      <MenuFlyoutItem x:Name="ContextMenuDeleteItem" AutomationProperties.AutomationId="AnnotationContextDeleteMenuItem" Click="OnContextMenuDelete">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                          <KeyboardAccelerator Key="Delete" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator />
                      <MenuFlyoutItem x:Name="ContextMenuRotate90Item" AutomationProperties.AutomationId="AnnotationContextRotate90MenuItem" Click="OnContextMenuRotate90">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextMenuResetRotationItem" AutomationProperties.AutomationId="AnnotationContextResetRotationMenuItem" Click="OnContextMenuResetRotation">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator />
                      <MenuFlyoutItem x:Name="ContextMenuFlipHItem" AutomationProperties.AutomationId="AnnotationContextFlipHorizontalMenuItem" Click="OnContextMenuFlipH">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xEA4F;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextMenuFlipVItem" AutomationProperties.AutomationId="AnnotationContextFlipVerticalMenuItem" Click="OnContextMenuFlipV">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xEA4E;" FontFamily="Segoe Fluent Icons" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </Grid.ContextFlyout>
                  <Image Source="{x:Bind ViewModel.ActiveDocumentTab.CurrentPageImage, Mode=OneWay}"
                         Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                         Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                         Stretch="None"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top" />

                  <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.CurrentPageAnnotationOverlays, Mode=OneWay}"
                                Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Grid />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WindowsAnnotationOverlayViewModel">
                        <Canvas Width="{x:Bind Width, Mode=OneWay}"
                                Height="{x:Bind Height, Mode=OneWay}"
                                Margin="{x:Bind services:XamlBindingHelpers.CreateThickness(Left, Top, 0, 0), Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Opacity="{x:Bind Opacity, Mode=OneWay}"
                                Visibility="{x:Bind services:XamlBindingHelpers.InverseBoolToVisibility(IsHidden), Mode=OneWay}">
                          <!-- Rotatable annotation content + selection -->
                          <Canvas Width="{x:Bind Width, Mode=OneWay}"
                                  Height="{x:Bind Height, Mode=OneWay}">
                            <Canvas.RenderTransform>
                              <RotateTransform Angle="{x:Bind RotationAngle, Mode=OneWay}"
                                               CenterX="{x:Bind RotationCenterX, Mode=OneWay}"
                                               CenterY="{x:Bind RotationCenterY, Mode=OneWay}" />
                            </Canvas.RenderTransform>
                            <Border Width="{x:Bind Width, Mode=OneWay}"
                                    Height="{x:Bind Height, Mode=OneWay}"
                                    Background="{x:Bind services:XamlBindingHelpers.BrushFromHex(FillHex, FillAlpha), Mode=OneWay}"
                                    BorderBrush="{x:Bind services:XamlBindingHelpers.BrushFromHex(StrokeHex, StrokeAlpha), Mode=OneWay}"
                                    BorderThickness="{x:Bind services:XamlBindingHelpers.CreateUniformThickness(BorderThicknessValue), Mode=OneWay}"
                                    CornerRadius="{x:Bind services:XamlBindingHelpers.CreateCornerRadius(CornerRadiusValue), Mode=OneWay}"
                                    Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsBoxVisible), Mode=OneWay}" />
                            <Polyline Points="{x:Bind services:XamlBindingHelpers.PointCollectionFromOverlayPoints(InkPoints), Mode=OneWay}"
                                      Stroke="{x:Bind services:XamlBindingHelpers.BrushFromHex(StrokeHex, StrokeAlpha), Mode=OneWay}"
                                      StrokeThickness="{x:Bind StrokeThickness, Mode=OneWay}"
                                      Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsInkVisible), Mode=OneWay}" />
                            <Image Width="{x:Bind Width, Mode=OneWay}"
                                   Height="{x:Bind Height, Mode=OneWay}"
                                   Source="{x:Bind services:XamlBindingHelpers.ImageSourceFromPath(SignatureImagePath), Mode=OneWay}"
                                   Stretch="Uniform"
                                   Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSignatureImageVisible), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                       Foreground="{x:Bind services:XamlBindingHelpers.BrushFromHex(TextHex, TextAlpha), Mode=OneWay}"
                                       FontSize="{x:Bind TextFontSize, Mode=OneWay}"
                                       FontFamily="{x:Bind TextFontFamily, Mode=OneWay}"
                                       Width="{x:Bind Width, Mode=OneWay}"
                                       Padding="4,2"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsTextVisible), Mode=OneWay}" />
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                      FontFamily="Segoe Fluent Icons"
                                      Foreground="{x:Bind services:XamlBindingHelpers.BrushFromHex(TextHex, TextAlpha), Mode=OneWay}"
                                      FontSize="16"
                                      Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsGlyphVisible), Mode=OneWay}" />
                            <!-- Selection box + rotate button (all rotate with content) -->
                            <Canvas Width="{x:Bind SelectionWidth, Mode=OneWay}"
                                    Height="{x:Bind SelectionHeight, Mode=OneWay}"
                                    Margin="{x:Bind services:XamlBindingHelpers.CreateThickness(SelectionOffsetLeft, SelectionOffsetTop, 0, 0), Mode=OneWay}"
                                    Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}">
                              <Rectangle Width="{x:Bind SelectionWidth, Mode=OneWay}"
                                         Height="{x:Bind SelectionHeight, Mode=OneWay}"
                                         Stroke="{ThemeResource AccentBrush}"
                                         StrokeThickness="2"
                                         StrokeDashArray="4,3"
                                         Fill="Transparent" />
                              <Ellipse Width="10" Height="10"
                                       Canvas.Left="-5" Canvas.Top="-5"
                                       Fill="{ThemeResource AccentBrush}" />
                              <Ellipse Width="10" Height="10"
                                       Canvas.Left="-5"
                                       Canvas.Top="{x:Bind services:XamlBindingHelpers.Subtract(SelectionHeight, 5), Mode=OneWay}"
                                       Fill="{ThemeResource AccentBrush}" />
                              <Ellipse Width="10" Height="10"
                                       Canvas.Top="-5"
                                       Canvas.Left="{x:Bind services:XamlBindingHelpers.Subtract(SelectionWidth, 5), Mode=OneWay}"
                                       Fill="{ThemeResource AccentBrush}" />
                              <Ellipse Width="10" Height="10"
                                       Canvas.Left="{x:Bind services:XamlBindingHelpers.Subtract(SelectionWidth, 5), Mode=OneWay}"
                                       Canvas.Top="{x:Bind services:XamlBindingHelpers.Subtract(SelectionHeight, 5), Mode=OneWay}"
                                       Fill="{ThemeResource AccentBrush}" />
                              <!-- Rotation stem line from top-center upward -->
                              <Line X1="0" Y1="0" X2="0" Y2="-10"
                                    Stroke="{ThemeResource AccentBrush}"
                                    StrokeThickness="1.5"
                                    Canvas.Top="0"
                                    Canvas.Left="{x:Bind RotateStemLeft, Mode=OneWay}" />
                              <!-- Rotation handle at top-center -->
                              <Grid Width="20" Height="20"
                                      Canvas.Left="{x:Bind RotateButtonLeft, Mode=OneWay}"
                                      Canvas.Top="{x:Bind RotateButtonTop, Mode=OneWay}">
                                <Ellipse Fill="{ThemeResource AccentBrush}" />
                                <FontIcon Glyph="&#xE7AD;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Grid>
                            </Canvas>
                          </Canvas>
                        </Canvas>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Grid Width="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.Width, Mode=OneWay, FallbackValue=180}"
                        Height="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.Height, Mode=OneWay, FallbackValue=72}"
                        Margin="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.Margin, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasInlineTextEditor), Mode=OneWay}">
                    <TextBox x:Name="InlineTextEditorBox"
                             AutomationProperties.AutomationId="InlineTextEditorTextBox"
                             Padding="4,2"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.StrokeBrush, Mode=OneWay}"
                             FontSize="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.FontSize, Mode=OneWay, FallbackValue=14}"
                             FontFamily="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.FontFamily, Mode=OneWay, FallbackValue='Segoe UI'}"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.InlineTextEditor.Text, Mode=OneWay}"
                             TextWrapping="Wrap"
                             TextChanged="OnInlineTextEditorTextChanged"
                             LostFocus="OnInlineTextEditorLostFocus"
                             KeyDown="OnInlineTextEditorKeyDown" />
                  </Grid>

                  <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.SearchHighlights, Mode=OneWay}"
                                Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasSearchHighlights), Mode=OneWay}"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Grid />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TextSelectionHighlightItem">
                        <Border Width="{x:Bind Width, Mode=OneWay}"
                                Height="{x:Bind Height, Mode=OneWay}"
                                Margin="{x:Bind Margin, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource SearchHighlightBrush}"
                                Opacity="0.34" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.TextSelectionHighlights, Mode=OneWay}"
                                Width="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelWidth, Mode=OneWay}"
                                Height="{x:Bind ViewModel.ActiveDocumentTab.CurrentPagePixelHeight, Mode=OneWay}"
                                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasTextSelectionHighlights), Mode=OneWay}"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Grid />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TextSelectionHighlightItem">
                        <Border Width="{x:Bind Width, Mode=OneWay}"
                                Height="{x:Bind Height, Mode=OneWay}"
                                Margin="{x:Bind Margin, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentBrush}"
                                Opacity="0.28" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Column="3"
            HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="8,0,0,0"
            Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.IsAnyRightPanelOpen), Mode=OneWay}">
        <Grid.TranslationTransition>
          <Vector3Transition Duration="0:0:0.2" />
        </Grid.TranslationTransition>
        <Border x:Name="AnnotationsPanel"
                Width="420"
                VerticalAlignment="Stretch"
                Background="{ThemeResource PanelDeepBrush}"
                BorderBrush="{ThemeResource PanelLineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.IsAnnotationsPanelOpen), Mode=OneWay}">
          <Grid Padding="20,20,20,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Labels.Annotations, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationDescriptionShort, Mode=OneWay}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Width="28"
                      AutomationProperties.AutomationId="AnnotationsPanelCloseButton"
                      Height="28"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Command="{x:Bind ViewModel.ToggleAnnotationsPanelCommand, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Close, Mode=OneWay}">
                <FontIcon Glyph="&#xE8BB;"
                          FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource TextSecondaryBrush}"
                          FontSize="12" />
              </Button>
            </Grid>

            <Border Grid.Row="1"
                    Height="38"
                    Margin="0,14,0,14"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
              <Grid Margin="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{ThemeResource ActiveToolBgBrush}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsAnnotationToolsTabSelected), Mode=OneWay}">
                  <Rectangle Height="2"
                             Width="40"
                             RadiusX="1"
                             RadiusY="1"
                             Fill="{ThemeResource AccentBrush}"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,2" />
                </Border>
                <Button Grid.Column="0"
                        AutomationProperties.AutomationId="AnnotationsToolsTabButton"
                        Height="32"
                        MinWidth="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{x:Bind ViewModel.SelectAnnotationPanelTabCommand, Mode=OneWay}"
                        CommandParameter="Tools"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.AnnotationToolsTab, Mode=OneWay}">
                  <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationToolsTab, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="13"
                             FontWeight="SemiBold" />
                </Button>

                <Border Grid.Column="1"
                        Background="{ThemeResource ActiveToolBgBrush}"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsAnnotationCommentsTabSelected), Mode=OneWay}">
                  <Rectangle Height="2"
                             Width="40"
                             RadiusX="1"
                             RadiusY="1"
                             Fill="{ThemeResource AccentBrush}"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,2" />
                </Border>
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="AnnotationsCommentsTabButton"
                        Height="32"
                        MinWidth="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{x:Bind ViewModel.SelectAnnotationPanelTabCommand, Mode=OneWay}"
                        CommandParameter="Comments"
                        AutomationProperties.Name="{x:Bind ViewModel.Labels.AnnotationCommentsTab, Mode=OneWay}">
                  <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationCommentsTab, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="13"
                             FontWeight="SemiBold" />
                </Button>
              </Grid>
            </Border>

            <Grid Grid.Row="2"
                  RowSpacing="8"
                  HorizontalAlignment="Stretch"
                  Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsAnnotationToolsAppearancePanelVisible), Mode=OneWay}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationActiveTool, Mode=OneWay}"
                         Foreground="{ThemeResource PanelLabelBrush}"
                         FontSize="13" />
              <Button Grid.Row="1"
                      AutomationProperties.AutomationId="AnnotationActiveToolMenuButton"
                      Height="42"
                      Background="{ThemeResource CardBrush}"
                      BorderBrush="{ThemeResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{ThemeResource OverlayCornerRadius}"
                      Padding="14,0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      ToolTipService.ToolTip="{x:Bind ViewModel.ActiveAnnotationToolLabel, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind ViewModel.ActiveAnnotationToolLabel, Mode=OneWay}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolSelectMenuItem" Text="{x:Bind ViewModel.Labels.Select, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Select" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolHighlightMenuItem" Text="{x:Bind ViewModel.Labels.Highlight, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Highlight" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolInkMenuItem" Text="{x:Bind ViewModel.Labels.Ink, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Ink" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolTextMenuItem" Text="{x:Bind ViewModel.Labels.Text, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Text" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolNoteMenuItem" Text="{x:Bind ViewModel.Labels.Note, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Note" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolRectangleMenuItem" Text="{x:Bind ViewModel.Labels.Rectangle, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Rectangle" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolSignatureMenuItem" Text="{x:Bind ViewModel.Labels.Signature, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Signature" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationActiveToolStampMenuItem" Text="{x:Bind ViewModel.Labels.Stamp, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Stamp" />
                  </MenuFlyout>
                </Button.Flyout>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border Width="22"
                          Height="22"
                          Background="{x:Bind services:XamlBindingHelpers.BrushFromHex(ViewModel.SelectedAnnotationColorHex, 255), Mode=OneWay}"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          VerticalAlignment="Center" />

                  <TextBlock Grid.Column="1"
                             Text="{x:Bind ViewModel.ActiveAnnotationToolLabel, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="14"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center" />

                  <FontIcon Grid.Column="2"
                            Glyph="&#xE70D;"
                            FontFamily="Segoe Fluent Icons"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            FontSize="11"
                            VerticalAlignment="Center" />
                </Grid>
              </Button>
            </Grid>

            <StackPanel Grid.Row="3"
                        Margin="0,12,0,0"
                        Spacing="10"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsAnnotationToolsTabSelected), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationQuickTools, Mode=OneWay}"
                         Foreground="{ThemeResource PanelLabelBrush}"
                         FontSize="13" />
              <ItemsControl AutomationProperties.AutomationId="AnnotationQuickToolsList"
                            ItemsSource="{x:Bind ViewModel.AnnotationTools, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   MaximumRowsOrColumns="4"
                                   ItemWidth="90"
                                   ItemHeight="68" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WindowsAnnotationToolItem">
                    <Button Width="82"
                            AutomationProperties.AutomationId="AnnotationQuickToolButton"
                            Height="58"
                            Margin="0"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Background="{x:Bind services:XamlBindingHelpers.BoolToSelectedToolBackground(IsSelected), Mode=OneWay}"
                            BorderBrush="{ThemeResource ButtonBorderBrush}"
                            BorderThickness="1"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                            Click="OnAnnotationToolClicked">
                      <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="20" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="6"
                          Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ShowAnnotationTextEditor), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationText, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <TextBox AutomationProperties.AutomationId="AnnotationTextDraftTextBox"
                         MinHeight="78"
                         Padding="10,8"
                         Background="{ThemeResource InputBrush}"
                         BorderBrush="{ThemeResource InputBorderBrush}"
                         BorderThickness="1"
                         CornerRadius="{ThemeResource OverlayCornerRadius}"
                         Foreground="{ThemeResource TextPrimaryBrush}"
                         PlaceholderText="{x:Bind ViewModel.Labels.AnnotationTextPlaceholder, Mode=OneWay}"
                         Text="{x:Bind ViewModel.AnnotationTextDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         KeyDown="OnAnnotationTextDraftKeyDown" />
              </StackPanel>

              <StackPanel Spacing="10"
                          Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ShowTextStyleControls), Mode=OneWay}">
                <TextBlock Text="Font"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <ComboBox AutomationProperties.AutomationId="AnnotationFontFamilyComboBox"
                          ItemsSource="{x:Bind ViewModel.AnnotationFontFamilyOptions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.AnnotationFontFamily, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          Background="{ThemeResource InputBrush}"
                          BorderBrush="{ThemeResource InputBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{ThemeResource OverlayCornerRadius}" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Size"
                             Foreground="{ThemeResource PanelLabelBrush}"
                             FontSize="13"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            AutomationProperties.AutomationId="AnnotationFontSizeComboBox"
                            Width="90"
                            ItemsSource="{x:Bind ViewModel.AnnotationFontSizeOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.AnnotationFontSize, Mode=TwoWay}"
                            Background="{ThemeResource InputBrush}"
                            BorderBrush="{ThemeResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="10"
                          Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ShowSignatureControls), Mode=OneWay}">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ViewModel.Labels.SignatureLibrary, Mode=OneWay}"
                             Foreground="{ThemeResource PanelLabelBrush}"
                             FontSize="13"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          AutomationProperties.AutomationId="SignatureImportImageButton"
                          Height="32"
                          MinWidth="0"
                          Padding="10,0"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Background="{ThemeResource CardBrush}"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          Command="{x:Bind ViewModel.ImportSignatureAssetCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <FontIcon Glyph="&#xE8E5;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13" />
                      <TextBlock Text="{x:Bind ViewModel.Labels.SignatureImportImage, Mode=OneWay}"
                                 FontSize="12" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2"
                          AutomationProperties.AutomationId="SignatureDeleteSelectedButton"
                          Width="32"
                          Height="32"
                          Padding="0"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Background="Transparent"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          Command="{x:Bind ViewModel.DeleteSelectedSignatureAssetCommand, Mode=OneWay}"
                          CommandParameter="{x:Bind ViewModel.SelectedSignatureAssetId, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.Labels.SignatureDeleteSelected, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.Labels.SignatureDeleteSelected, Mode=OneWay}">
                    <FontIcon Glyph="&#xE74D;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="13" />
                  </Button>
                </Grid>

                <ScrollViewer MaxHeight="132"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.HasSignatureAssets), Mode=OneWay}">
                  <ItemsControl AutomationProperties.AutomationId="SignatureAssetsList"
                                ItemsSource="{x:Bind ViewModel.SignatureAssets, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="domain:SignatureAsset">
                        <Border Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Padding="10,8"
                                Margin="0,0,0,6">
                          <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Background="Transparent"
                                    AutomationProperties.AutomationId="SignatureAssetSelectButton"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OnSignatureAssetClicked">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FilePath, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="SignatureAssetDeleteButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnDeleteSignatureAssetClicked">
                              <FontIcon Glyph="&#xE74D;"
                                        FontFamily="Segoe Fluent Icons"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        FontSize="13" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{x:Bind ViewModel.Labels.SignatureDraw, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <TextBox AutomationProperties.AutomationId="SignatureNameTextBox"
                         Height="36"
                         Padding="10,0"
                         Background="{ThemeResource InputBrush}"
                         BorderBrush="{ThemeResource InputBorderBrush}"
                         BorderThickness="1"
                         CornerRadius="{ThemeResource OverlayCornerRadius}"
                         Foreground="{ThemeResource TextPrimaryBrush}"
                         PlaceholderText="{x:Bind ViewModel.Labels.SignatureNamePlaceholder, Mode=OneWay}"
                         Text="{x:Bind ViewModel.SignatureAssetNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Border Height="146"
                        Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="10">
                  <Grid HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Rectangle Width="248"
                               Height="124"
                               Fill="{ThemeResource SignaturePadBgBrush}"
                               RadiusX="4"
                               RadiusY="4" />
                    <Polyline Points="{x:Bind services:XamlBindingHelpers.PointCollectionFromSignaturePadPoints(ViewModel.SignaturePadPoints), Mode=OneWay}"
                              Stroke="{ThemeResource SignatureInkBrush}"
                              StrokeThickness="2.2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    <Border x:Name="SignaturePadInteractionLayer"
                            AutomationProperties.AutomationId="SignaturePadDrawingSurface"
                            Width="248"
                            Height="124"
                            Background="Transparent"
                            PointerPressed="OnSignaturePadPointerPressed"
                            PointerMoved="OnSignaturePadPointerMoved"
                            PointerReleased="OnSignaturePadPointerReleased"
                            PointerCanceled="OnSignaturePadPointerCanceled" />
                  </Grid>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                  <Button Height="32"
                          AutomationProperties.AutomationId="SignatureClearDrawingButton"
                          MinWidth="0"
                          Padding="10,0"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Background="{ThemeResource CardBrush}"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          Command="{x:Bind ViewModel.ClearSignatureCaptureCommand, Mode=OneWay}"
                          Content="{x:Bind ViewModel.Labels.SignatureClearDrawing, Mode=OneWay}" />
                  <Button Height="32"
                          AutomationProperties.AutomationId="SignatureSaveButton"
                          MinWidth="0"
                          Padding="10,0"
                          CornerRadius="{ThemeResource OverlayCornerRadius}"
                          Background="{ThemeResource AccentBgBrush}"
                          BorderBrush="{ThemeResource AccentBrush}"
                          BorderThickness="1"
                          Command="{x:Bind ViewModel.SaveDrawnSignatureAssetCommand, Mode=OneWay}"
                          Content="{x:Bind ViewModel.Labels.SignatureSave, Mode=OneWay}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Margin="0,2,0,0"
                        Spacing="8"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsAnnotationToolsAppearancePanelVisible), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationColor, Mode=OneWay}"
                         Foreground="{ThemeResource PanelLabelBrush}"
                         FontSize="13" />
              <ItemsControl AutomationProperties.AutomationId="AnnotationStrokeColorList"
                            ItemsSource="{x:Bind ViewModel.AnnotationColorOptions, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WindowsAnnotationColorItem">
                    <Button Width="30"
                            AutomationProperties.AutomationId="AnnotationStrokeColorButton"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind Hex, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Hex, Mode=OneWay}"
                            Click="OnAnnotationColorClicked">
                      <Grid>
                        <Ellipse Width="24"
                                 Height="24"
                                 Fill="{x:Bind Brush, Mode=OneWay}" />
                        <Ellipse Width="30"
                                 Height="30"
                                 Stroke="{ThemeResource AccentBrush}"
                                 StrokeThickness="3"
                                 Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                        <Ellipse Width="20"
                                 Height="20"
                                 Stroke="{ThemeResource TextPrimaryBrush}"
                                 StrokeThickness="1"
                                 Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="5"
                        Margin="0,10,0,0"
                        Spacing="6"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsAnnotationToolsAppearancePanelVisible), Mode=OneWay}">
              <Grid>
                <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationOpacity, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <TextBlock Text="{x:Bind ViewModel.AnnotationOpacityText, Mode=OneWay}"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Right" />
              </Grid>
              <Slider AutomationProperties.AutomationId="AnnotationOpacitySlider"
                      Minimum="0"
                      Maximum="100"
                      Value="{x:Bind ViewModel.AnnotationOpacity, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Row="6"
                        Margin="0,10,0,0"
                        Spacing="8"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ShowRectangleFillControls), Mode=OneWay}">
              <CheckBox AutomationProperties.AutomationId="AnnotationFillCheckBox"
                        Content="{x:Bind ViewModel.Labels.AnnotationFill, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.AnnotationFillEnabled, Mode=TwoWay}" />
              <StackPanel Spacing="6"
                          Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.AnnotationFillEnabled), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationFillColor, Mode=OneWay}"
                           Foreground="{ThemeResource PanelLabelBrush}"
                           FontSize="13" />
                <ItemsControl AutomationProperties.AutomationId="AnnotationFillColorList"
                              ItemsSource="{x:Bind ViewModel.AnnotationFillColorOptions, Mode=OneWay}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WindowsAnnotationColorItem">
                      <Button Width="28"
                              AutomationProperties.AutomationId="AnnotationFillColorButton"
                              Height="28"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTipService.ToolTip="{x:Bind Hex, Mode=OneWay}"
                              Click="OnAnnotationFillColorClicked">
                        <Grid>
                          <Ellipse Width="22"
                                   Height="22"
                                   Fill="{x:Bind Brush, Mode=OneWay}" />
                          <Ellipse Width="28"
                                   Height="28"
                                   Stroke="{ThemeResource AccentBrush}"
                                   StrokeThickness="3"
                                   Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <Border Grid.Row="7"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{ThemeResource AnnotationSeparatorBrush}"
                    BorderThickness="0"
                    Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsAnnotationToolsTabSelected), Mode=OneWay}">
              <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                  <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationCurrent, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="14" />
                  <Border HorizontalAlignment="Right"
                          Padding="10,4"
                          Background="{ThemeResource CardBrush}"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationRecent, Mode=OneWay}"
                                 Foreground="{ThemeResource TextPrimaryBrush}"
                                 FontSize="12" />
                      <FontIcon Glyph="&#xE70D;"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                FontSize="10"
                                VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid Grid.Row="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasCurrentPageAnnotations), Mode=OneWay}">
                    <ItemsControl AutomationProperties.AutomationId="CurrentPageAnnotationsList"
                                  ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.CurrentPageAnnotationOverlays, Mode=OneWay}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WindowsAnnotationOverlayViewModel">
                          <Border Background="{ThemeResource CardBrush}"
                                  AutomationProperties.AutomationId="AnnotationListItem"
                                  BorderBrush="{ThemeResource CardBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{ThemeResource OverlayCornerRadius}"
                                  Padding="12,10"
                                  Margin="0,0,0,8"
                                  Opacity="{x:Bind ListItemOpacity, Mode=OneWay}"
                                  Tapped="OnAnnotationListItemTapped">
                            <Grid ColumnSpacing="12">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <Grid Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0">
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="{x:Bind services:XamlBindingHelpers.BrushFromHex(StrokeHex, StrokeAlpha), Mode=OneWay}"
                                          FontSize="18" />
                                <FontIcon Glyph="&#xE72E;"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource TextSecondaryBrush}"
                                          FontSize="10"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,-4,-4"
                                          Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsLockIconVisible), Mode=OneWay}" />
                                <FontIcon Glyph="&#xED1A;"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="{ThemeResource TextSecondaryBrush}"
                                          FontSize="10"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Bottom"
                                          Margin="-4,0,0,-4"
                                          Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(IsHiddenIconVisible), Mode=OneWay}" />
                              </Grid>

                              <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind PageLabel, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBlock Text="{x:Bind PreviewText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(HasPreviewText), Mode=OneWay}" />
                              </StackPanel>

                              <StackPanel Grid.Column="2"
                                          Orientation="Horizontal"
                                          Spacing="6"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0">
                                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <Button Width="28"
                                        AutomationProperties.AutomationId="AnnotationListItemMenuButton"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                  <FontIcon Glyph="&#xE712;"
                                            FontFamily="Segoe Fluent Icons"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            FontSize="13" />
                                  <Button.Flyout>
                                    <MenuFlyout>
                                      <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationListEditMenuItem"
                                                      Text="{x:Bind AnnotationMenuEditLabel, Mode=OneWay}"
                                                      Tag="{x:Bind Id, Mode=OneWay}"
                                                      Click="OnAnnotationMenuEditClicked">
                                        <MenuFlyoutItem.Icon>
                                          <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                      <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationListHideMenuItem"
                                                      Text="{x:Bind HideMenuText, Mode=OneWay}"
                                                      Tag="{x:Bind Id, Mode=OneWay}"
                                                      Click="OnAnnotationMenuHideClicked">
                                        <MenuFlyoutItem.Icon>
                                          <FontIcon Glyph="&#xED1A;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                      <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationListLockMenuItem"
                                                      Text="{x:Bind LockMenuText, Mode=OneWay}"
                                                      Tag="{x:Bind Id, Mode=OneWay}"
                                                      Click="OnAnnotationMenuLockClicked">
                                        <MenuFlyoutItem.Icon>
                                          <FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                      <MenuFlyoutSeparator />
                                      <MenuFlyoutItem AutomationProperties.AutomationId="AnnotationListDeleteMenuItem"
                                                      Text="{x:Bind AnnotationMenuDeleteLabel, Mode=OneWay}"
                                                      Tag="{x:Bind Id, Mode=OneWay}"
                                                      Click="OnAnnotationMenuDeleteClicked">
                                        <MenuFlyoutItem.Icon>
                                          <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
                                        </MenuFlyoutItem.Icon>
                                      </MenuFlyoutItem>
                                    </MenuFlyout>
                                  </Button.Flyout>
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <StackPanel VerticalAlignment="Top"
                              HorizontalAlignment="Center"
                              Spacing="10"
                              Margin="0,96,0,0"
                              Visibility="{x:Bind services:XamlBindingHelpers.InverseBoolToVisibility(ViewModel.ActiveDocumentTab.HasCurrentPageAnnotations), Mode=OneWay}">
                    <FontIcon Glyph="&#xE90A;"
                              FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource EmptyStateIconBrush}"
                              FontSize="38"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationEmptyPage, Mode=OneWay}"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationEmptyHint, Mode=OneWay}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"
                               Width="260" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Row="7"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{ThemeResource AnnotationSeparatorBrush}"
                    BorderThickness="0"
                    Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.IsAnnotationCommentsTabSelected), Mode=OneWay}">
              <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                  <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationCommentsCurrent, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="14" />
                  <Border HorizontalAlignment="Right"
                          Padding="10,4"
                          Background="{ThemeResource CardBrush}"
                          BorderBrush="{ThemeResource CardBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <TextBlock Text="{x:Bind ViewModel.ActiveDocumentTab.CurrentPageCommentCountText, Mode=OneWay}"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               FontSize="12" />
                  </Border>
                </Grid>

                <Grid Grid.Row="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasCurrentPageComments), Mode=OneWay}">
                    <ItemsControl AutomationProperties.AutomationId="CurrentPageCommentsList"
                                  ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.CurrentPageCommentOverlays, Mode=OneWay}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WindowsCommentOverlayViewModel">
                          <Border Background="{ThemeResource CardBrush}"
                                  BorderBrush="{ThemeResource CardBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{ThemeResource OverlayCornerRadius}"
                                  Padding="12,10"
                                  Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <FontIcon Grid.Column="0"
                                        Glyph="&#xE90A;"
                                        FontFamily="Segoe Fluent Icons"
                                        Foreground="{x:Bind StrokeBrush, Mode=OneWay}"
                                        FontSize="18"
                                        VerticalAlignment="Top"
                                        Margin="0,2,0,0" />

                              <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           MaxLines="3" />
                                <TextBlock Text="{x:Bind PageLabel, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11" />
                              </StackPanel>

                              <StackPanel Grid.Column="2"
                                          Orientation="Horizontal"
                                          Spacing="6"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0">
                                <TextBlock Text="{x:Bind TimeText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <Button Width="28"
                                        AutomationProperties.AutomationId="CommentListItemMenuButton"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTipService.ToolTip="{x:Bind AnnotationDeleteSelectedLabel, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind AnnotationDeleteSelectedLabel, Mode=OneWay}"
                                        Tapped="OnDeleteAnnotationTapped">
                                  <FontIcon Glyph="&#xE712;"
                                            FontFamily="Segoe Fluent Icons"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            FontSize="13" />
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <StackPanel VerticalAlignment="Top"
                              HorizontalAlignment="Center"
                              Spacing="10"
                              Margin="0,96,0,0"
                              Visibility="{x:Bind services:XamlBindingHelpers.InverseBoolToVisibility(ViewModel.ActiveDocumentTab.HasCurrentPageComments), Mode=OneWay}">
                    <FontIcon Glyph="&#xE90A;"
                              FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource EmptyStateIconBrush}"
                              FontSize="38"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationCommentsEmptyPage, Mode=OneWay}"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Labels.AnnotationCommentsEmptyHint, Mode=OneWay}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"
                               Width="260" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <Button Grid.Row="8"
                    AutomationProperties.AutomationId="AnnotationsPanelCollapseButton"
                    HorizontalAlignment="Right"
                    Width="40"
                    Height="36"
                    Margin="0,8,0,0"
                    Padding="0"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Command="{x:Bind ViewModel.ToggleAnnotationsPanelCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Annotations, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.Labels.Annotations, Mode=OneWay}">
              <TextBlock Text="&#x00AB;"
                         Foreground="{ThemeResource TextPrimaryBrush}"
                         FontSize="22" />
            </Button>
          </Grid>
        </Border>

        <Border x:Name="SettingsPanel"
                Width="356"
                Background="{ThemeResource PanelDeepBrush}"
                BorderBrush="{ThemeResource PanelLineBrush}"
                BorderThickness="1,0,0,0"
                CornerRadius="0"
                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.IsSettingsPanelOpen), Mode=OneWay}">
          <StackPanel Padding="18,14" Spacing="16">
            <StackPanel Spacing="5">
              <TextBlock Text="{x:Bind ViewModel.Labels.Settings, Mode=OneWay}" Style="{StaticResource PanelTitleStyle}" />
              <TextBlock Text="{x:Bind ViewModel.Labels.PreferencesDescription, Mode=OneWay}"
                         Foreground="{ThemeResource TextSecondaryBrush}"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="14">
              <StackPanel Spacing="14">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ViewModel.Labels.PreferencesLanguage, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            AutomationProperties.AutomationId="PreferencesLanguageComboBox"
                            ItemsSource="{x:Bind ViewModel.PreferenceLanguageOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedPreferenceLanguage, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ViewModel.Labels.PreferencesTheme, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            AutomationProperties.AutomationId="PreferencesThemeComboBox"
                            ItemsSource="{x:Bind ViewModel.PreferenceThemeOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedPreferenceTheme, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ViewModel.Labels.PreferencesDefaultZoom, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            AutomationProperties.AutomationId="PreferencesDefaultZoomComboBox"
                            ItemsSource="{x:Bind ViewModel.PreferenceZoomOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedPreferenceZoom, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ViewModel.Labels.PreferencesShowThumbnails, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <ToggleSwitch Grid.Column="1"
                                AutomationProperties.AutomationId="PreferencesShowThumbnailsToggle"
                                IsOn="{x:Bind ViewModel.ShowThumbnails, Mode=TwoWay}"
                                OnContent=""
                                OffContent="" />
                </Grid>

                <StackPanel Spacing="6">
                  <Grid>
                    <TextBlock Text="{x:Bind ViewModel.Labels.PreferencesCacheSize, Mode=OneWay}"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" />
                  </Grid>
                  <Slider AutomationProperties.AutomationId="PreferencesCacheSizeSlider"
                          Minimum="64"
                          Maximum="1024"
                          Value="{x:Bind ViewModel.CacheSizeMegabytes, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border x:Name="InfoPanel"
                Width="420"
                VerticalAlignment="Stretch"
                Background="{ThemeResource PanelDeepBrush}"
                BorderBrush="{ThemeResource PanelLineBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.IsInfoPanelOpen), Mode=OneWay}">
          <Grid Padding="20,20,20,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Labels.Info, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.Labels.InfoDescription, Mode=OneWay}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Width="28"
                      AutomationProperties.AutomationId="InfoPanelCloseButton"
                      Height="28"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Command="{x:Bind ViewModel.ToggleInfoPanelCommand, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Close, Mode=OneWay}">
                <FontIcon Glyph="&#xE8BB;"
                          FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource TextSecondaryBrush}"
                          FontSize="12" />
              </Button>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="14">
              <StackPanel Spacing="10">
                <TextBlock Text="{x:Bind ViewModel.ActiveDocumentTab.Title, Mode=OneWay}"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <Grid ColumnSpacing="12" RowSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0"
                             Text="{x:Bind ViewModel.Labels.InfoFileSize, Mode=OneWay}"
                             Style="{StaticResource PanelLabelStyle}" />
                  <TextBlock Grid.Row="0" Grid.Column="1"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.FileSize, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}" />

                  <TextBlock Grid.Row="1" Grid.Column="0"
                             Text="{x:Bind ViewModel.Labels.InfoDimensions, Mode=OneWay}"
                             Style="{StaticResource PanelLabelStyle}" />
                  <TextBlock Grid.Row="1" Grid.Column="1"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.Dimensions, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}" />

                  <TextBlock Grid.Row="2" Grid.Column="0"
                             Text="{x:Bind ViewModel.Labels.InfoPages, Mode=OneWay}"
                             Style="{StaticResource PanelLabelStyle}" />
                  <TextBlock Grid.Row="2" Grid.Column="1"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.PageCountText, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}" />

                  <TextBlock Grid.Row="3" Grid.Column="0"
                             Text="{x:Bind ViewModel.Labels.InfoFormat, Mode=OneWay}"
                             Style="{StaticResource PanelLabelStyle}" />
                  <TextBlock Grid.Row="3" Grid.Column="1"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.Format, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}" />

                  <TextBlock Grid.Row="4" Grid.Column="0"
                             Text="{x:Bind ViewModel.Labels.InfoAuthor, Mode=OneWay}"
                             Style="{StaticResource PanelLabelStyle}" />
                  <TextBlock Grid.Row="4" Grid.Column="1"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.Author, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}" />

                  <TextBlock Grid.Row="5" Grid.Column="0"
                             Text="{x:Bind ViewModel.Labels.InfoCreated, Mode=OneWay}"
                             Style="{StaticResource PanelLabelStyle}" />
                  <TextBlock Grid.Row="5" Grid.Column="1"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.CreatedDate, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}" />

                  <TextBlock Grid.Row="6" Grid.Column="0"
                             Text="{x:Bind ViewModel.Labels.InfoModified, Mode=OneWay}"
                             Style="{StaticResource PanelLabelStyle}" />
                  <TextBlock Grid.Row="6" Grid.Column="1"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.ModifiedDate, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border x:Name="SearchPanel"
                Width="356"
                VerticalAlignment="Stretch"
                Background="{ThemeResource PanelDeepBrush}"
                BorderBrush="{ThemeResource PanelLineBrush}"
                BorderThickness="1,0,0,0"
                CornerRadius="0"
                Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.IsSearchPanelOpen), Mode=OneWay}">
          <Grid Padding="18,14" RowSpacing="14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="5">
              <TextBlock Text="{x:Bind ViewModel.Labels.Search, Mode=OneWay}" Style="{StaticResource PanelTitleStyle}" />
              <TextBlock Text="{x:Bind ViewModel.Labels.SearchDescription, Mode=OneWay}"
                         Foreground="{ThemeResource TextSecondaryBrush}"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="10,8"
                    Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasSearchPanelNotice), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.ActiveDocumentTab.SearchPanelNotice, Mode=OneWay}"
                         Foreground="{ThemeResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="2" Spacing="8">
              <TextBlock Text="{x:Bind ViewModel.Labels.SearchQuery, Mode=OneWay}"
                         Style="{StaticResource PanelLabelStyle}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Height="38"
                        Background="{ThemeResource SearchBrush}"
                        BorderBrush="{ThemeResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;"
                              FontFamily="Segoe Fluent Icons"
                              Foreground="{ThemeResource TextSecondaryBrush}"
                              Margin="12,0,8,0"
                              VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             AutomationProperties.AutomationId="SearchPanelQueryTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             PlaceholderText="{x:Bind ViewModel.Labels.SearchQueryPlaceholder, Mode=OneWay}"
                             Text="{x:Bind ViewModel.ActiveDocumentTab.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchBoxKeyDown" />
                  </Grid>
                </Border>

                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="SearchPanelSearchButton"
                        Height="38"
                        MinWidth="78"
                        Content="{x:Bind ViewModel.Labels.Search, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SearchTextCommand, Mode=OneWay}" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        Spacing="8">
              <Button AutomationProperties.AutomationId="SearchPanelRecognizeButton"
                      Content="{x:Bind ViewModel.Labels.SearchRecognize, Mode=OneWay}"
                      Command="{x:Bind ViewModel.RunSearchOcrCommand, Mode=OneWay}"
                      Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.RequiresSearchOcr), Mode=OneWay}" />
              <ProgressRing Width="24"
                            Height="24"
                            IsActive="{x:Bind ViewModel.ActiveDocumentTab.IsAnalyzingDocumentText, Mode=OneWay}"
                            Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.IsAnalyzingDocumentText), Mode=OneWay}" />
            </StackPanel>

            <Border Grid.Row="4"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="10"
                    Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasSearchResults), Mode=OneWay}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{x:Bind ViewModel.ActiveDocumentTab.SearchResultSummary, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{x:Bind ViewModel.ActiveDocumentTab.SearchSelectionIndicator, Mode=OneWay}"
                             Foreground="{ThemeResource TextSecondaryBrush}"
                             FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Width="32"
                          AutomationProperties.AutomationId="SearchPreviousResultButton"
                          Height="32"
                          Padding="0"
                          Command="{x:Bind ViewModel.PreviousSearchResultCommand, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.Labels.SearchPreviousResult, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.Labels.SearchPreviousResult, Mode=OneWay}">
                    <FontIcon Glyph="&#xE70E;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                  </Button>
                  <Button Width="32"
                          AutomationProperties.AutomationId="SearchNextResultButton"
                          Height="32"
                          Padding="0"
                          Command="{x:Bind ViewModel.NextSearchResultCommand, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.Labels.SearchNextResult, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind ViewModel.Labels.SearchNextResult, Mode=OneWay}">
                    <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <ListView Grid.Row="5"
                      AutomationProperties.AutomationId="SearchResultsList"
                      ItemsSource="{x:Bind ViewModel.ActiveDocumentTab.SearchResults, Mode=OneWay}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      SelectionChanged="OnSearchResultSelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind services:XamlBindingHelpers.BoolToVisibility(ViewModel.ActiveDocumentTab.HasSearchResults), Mode=OneWay}">
              <ListView.ItemTemplate>
                  <DataTemplate x:DataType="vm:WindowsSearchResultItemViewModel">
                    <Border Background="{ThemeResource CardBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Padding="10"
                            Margin="0,0,0,8">
                      <StackPanel Spacing="5">
                        <TextBlock Text="{x:Bind PageLabel, Mode=OneWay}"
                                   Foreground="{ThemeResource PanelLabelBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Excerpt, Mode=OneWay}"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>

      </Grid>
    </Grid>

    <Border Grid.Row="4"
            Background="{ThemeResource TitleBarBgBrush}"
            BorderBrush="{ThemeResource PanelLineBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,4">
      <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 Foreground="{ThemeResource TextSecondaryBrush}"
                 FontSize="12"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>

  </Grid>
</Window>
