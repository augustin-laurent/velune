<Window
    x:Class="Velune.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:Velune.Domain.Annotations"
    xmlns:services="using:Velune.Windows.Services"
    xmlns:vm="using:Velune.Windows.ViewModels">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root"
        Background="Transparent">

    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="C"
                           Modifiers="Control"
                           Invoked="OnCopySelectedTextKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="F"
                           Modifiers="Control"
                           Invoked="OnSearchKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="S"
                           Modifiers="Control"
                           Invoked="OnSaveKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Z"
                           Modifiers="Control"
                           Invoked="OnUndoKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Y"
                           Modifiers="Control"
                           Invoked="OnRedoKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Delete"
                           Invoked="OnDeleteAnnotationKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Right"
                           Modifiers="Shift"
                           Invoked="OnExtendSelectionRightKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Left"
                           Modifiers="Shift"
                           Invoked="OnShrinkSelectionLeftKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Right"
                           Modifiers="Control,Shift"
                           Invoked="OnExtendSelectionWordRightKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Left"
                           Modifiers="Control,Shift"
                           Invoked="OnShrinkSelectionWordLeftKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="R"
                           Modifiers="Control"
                           Invoked="OnRotateRightKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="R"
                           Modifiers="Control,Shift"
                           Invoked="OnRotateLeftKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Number0"
                           Modifiers="Control"
                           Invoked="OnFitPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Number1"
                           Modifiers="Control"
                           Invoked="OnActualSizeKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="H"
                           Modifiers="Control,Shift"
                           Invoked="OnFlipHorizontalKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Right"
                           Invoked="OnNextPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Left"
                           Invoked="OnPreviousPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="PageDown"
                           Invoked="OnNextPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="PageUp"
                           Invoked="OnPreviousPageKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Add"
                           Modifiers="Control"
                           Invoked="OnZoomInKeyboardAcceleratorInvoked" />
      <KeyboardAccelerator Key="Subtract"
                           Modifiers="Control"
                           Invoked="OnZoomOutKeyboardAcceleratorInvoked" />
    </Grid.KeyboardAccelerators>

    <Grid.Resources>
      <ResourceDictionary>
        <services:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <services:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <services:AnnotationToolBackgroundConverter x:Key="AnnotationToolBackground" />
        <services:BoolToSelectedToolBackgroundConverter x:Key="BoolToSelectedToolBackground" />
        <services:SubtractConverter x:Key="SubtractConverter" />

        <Style x:Key="TitleBarIconButtonStyle" TargetType="Button">
          <Setter Property="Width" Value="42" />
          <Setter Property="Height" Value="42" />
          <Setter Property="MinWidth" Value="42" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="RibbonIconButtonStyle" TargetType="Button">
          <Setter Property="Width" Value="40" />
          <Setter Property="Height" Value="40" />
          <Setter Property="MinWidth" Value="40" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="RibbonTextButtonStyle" TargetType="Button">
          <Setter Property="Height" Value="40" />
          <Setter Property="MinWidth" Value="40" />
          <Setter Property="Padding" Value="10,0" />
          <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="TopNavButtonStyle" TargetType="Button">
          <Setter Property="Height" Value="38" />
          <Setter Property="Padding" Value="14,0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
          <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="RibbonLabelStyle" TargetType="TextBlock">
          <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <Style x:Key="RibbonSeparatorStyle" TargetType="Rectangle">
          <Setter Property="Width" Value="1" />
          <Setter Property="Height" Value="64" />
          <Setter Property="Fill" Value="{ThemeResource DividerBrush}" />
          <Setter Property="Opacity" Value="0.55" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="Margin" Value="14,0" />
        </Style>

        <Style x:Key="RibbonPillBorderStyle" TargetType="Border">
          <Setter Property="Padding" Value="1" />
          <Setter Property="Background" Value="{ThemeResource InputBrush}" />
          <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RibbonPillButtonStyle" TargetType="Button">
          <Setter Property="Height" Value="36" />
          <Setter Property="MinWidth" Value="40" />
          <Setter Property="Padding" Value="12,0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
          <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="UseSystemFocusVisuals" Value="True" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Grid x:Name="TemplateRoot"
                      MinWidth="{TemplateBinding MinWidth}"
                      Height="{TemplateBinding Height}"
                      Background="Transparent">
                  <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                      <VisualState x:Name="Normal" />

                      <VisualState x:Name="PointerOver">
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                           Storyboard.TargetProperty="Opacity"
                                           To="1"
                                           Duration="0:0:0.08" />
                        </Storyboard>
                      </VisualState>

                      <VisualState x:Name="Pressed">
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="PressedLayer"
                                           Storyboard.TargetProperty="Opacity"
                                           To="1"
                                           Duration="0:0:0.03" />
                        </Storyboard>
                      </VisualState>

                      <VisualState x:Name="Disabled">
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="DisabledLayer"
                                           Storyboard.TargetProperty="Opacity"
                                           To="1"
                                           Duration="0:0:0" />
                          <DoubleAnimation Storyboard.TargetName="ContentPresenter"
                                           Storyboard.TargetProperty="Opacity"
                                           To="0.45"
                                           Duration="0:0:0" />
                        </Storyboard>
                      </VisualState>
                    </VisualStateGroup>
                  </VisualStateManager.VisualStateGroups>

                  <Border x:Name="BaseLayer"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}" />

                  <Border x:Name="HoverLayer"
                          Background="{ThemeResource ActiveToolBrush}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Opacity="0" />

                  <Border x:Name="PressedLayer"
                          Background="{ThemeResource ActiveToolBorderBrush}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Opacity="0" />

                  <Border x:Name="DisabledLayer"
                          Background="{ThemeResource DisabledLayerBrush}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Opacity="0" />

                  <ContentPresenter x:Name="ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>

        <Style x:Key="RibbonPillIconButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonPillButtonStyle}">
          <Setter Property="Width" Value="38" />
          <Setter Property="MinWidth" Value="38" />
          <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="RibbonPillDividerStyle" TargetType="Rectangle">
          <Setter Property="Width" Value="1" />
          <Setter Property="Height" Value="22" />
          <Setter Property="Fill" Value="{ThemeResource DividerBrush}" />
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
          <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PanelLabelStyle" TargetType="TextBlock">
          <Setter Property="Foreground" Value="{ThemeResource PanelLabelBrush}" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AnnotationToolStyle" TargetType="Button">
          <Setter Property="Width" Value="78" />
          <Setter Property="Height" Value="58" />
          <Setter Property="Margin" Value="0" />
          <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
          <Setter Property="Background" Value="{ThemeResource CardBrush}" />
          <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

      </ResourceDictionary>
    </Grid.Resources>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="RibbonAdaptiveStates">
        <VisualState x:Name="RibbonCompact">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SearchBoxBorder.MinWidth" Value="420" />
            <Setter Target="SearchBoxBorder.MaxWidth" Value="1200" />
            <Setter Target="AnnotateBtnNote.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnStamp.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnInk.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnErase.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>

        <VisualState x:Name="RibbonMedium">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1550" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SearchBoxBorder.MinWidth" Value="520" />
            <Setter Target="SearchBoxBorder.MaxWidth" Value="1200" />
            <Setter Target="AnnotateBtnNote.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnStamp.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnInk.Visibility" Value="Collapsed" />
            <Setter Target="AnnotateBtnErase.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>

        <VisualState x:Name="RibbonWide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1750" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SearchBoxBorder.MinWidth" Value="640" />
            <Setter Target="SearchBoxBorder.MaxWidth" Value="1400" />
            <Setter Target="AnnotateBtnNote.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnStamp.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnInk.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnErase.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>

        <VisualState x:Name="RibbonExtraWide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1950" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="SearchBoxBorder.MinWidth" Value="760" />
            <Setter Target="SearchBoxBorder.MaxWidth" Value="1800" />
            <Setter Target="AnnotateBtnNote.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnStamp.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnInk.Visibility" Value="Visible" />
            <Setter Target="AnnotateBtnErase.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="50" />
      <RowDefinition Height="40" />
      <RowDefinition Height="106" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBarDragRegion"
          Grid.Row="0"
          Padding="18,0,150,0"
          Background="{ThemeResource TitleBarBgBrush}">

      <Border x:Name="TitleBarDragHandle"
              Margin="-18,0,-150,0"
              Background="{ThemeResource TitleBarBgBrush}" />

      <StackPanel x:Name="TitleBarInteractiveRegion"
                  Orientation="Horizontal"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Spacing="4">
        <ItemsControl AutomationProperties.AutomationId="DocumentTabsList"
                      ItemsSource="{x:Bind ViewModel.DocumentTabs, Mode=OneWay}"
                      Height="46"
                      VerticalAlignment="Bottom">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WindowsDocumentTabViewModel">
              <Border Width="250"
                      Height="36"
                      Margin="2,0"
                      Background="{x:Bind services:XamlBindingHelpers.DocumentTabBackground(TabChromeState, IsLightTheme), Mode=OneWay}"
                      BorderBrush="{x:Bind services:XamlBindingHelpers.DocumentTabBorderBrush(TabChromeState, IsLightTheme), Mode=OneWay}"
                      BorderThickness="1"
                      CornerRadius="{ThemeResource OverlayCornerRadius}"
                      PointerEntered="OnTabPointerEntered"
                      PointerExited="OnTabPointerExited">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <FontIcon Glyph="&#xE8A5;"
                            FontFamily="Segoe Fluent Icons"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            FontSize="14"
                            Margin="12,0,8,0"
                            VerticalAlignment="Center" />

                  <TextBlock Grid.Column="1"
                             Text="{x:Bind Title, Mode=OneWay}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />

                  <Button Grid.Column="0"
                          AutomationProperties.AutomationId="DocumentTabSelectButton"
                          Grid.ColumnSpan="2"
                          MinWidth="0"
                          Padding="0"
                          Background="Transparent"
                          BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Click="OnTabClicked" />

                  <Button Grid.Column="2"
                          AutomationProperties.AutomationId="DocumentTabCloseButton"
                          Width="30"
                          Height="30"
                          Margin="4,0,8,0"
                          Padding="0"
                          Background="Transparent"
                          BorderThickness="0"
                          Click="OnCloseTabClicked"
                          ToolTipService.ToolTip="{x:Bind CloseTabLabel, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind CloseTabLabel, Mode=OneWay}"
                          VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8BB;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="10" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource TitleBarIconButtonStyle}"
                Command="{x:Bind ViewModel.OpenCommand, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.Labels.Open, Mode=OneWay}"
                AutomationProperties.AutomationId="TitleBarOpenButton"
                AutomationProperties.Name="{x:Bind ViewModel.Labels.Open, Mode=OneWay}">
          <FontIcon Glyph="&#xE710;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1"
          Background="{ThemeResource MenuBarBrush}"
          BorderBrush="{ThemeResource MenuBarBorderBrush}"
          BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal"
                  Padding="18,0,0,0"
                  Spacing="4"
                  VerticalAlignment="Center">
        <Button Content="{x:Bind ViewModel.Labels.File, Mode=OneWay}"
                AutomationProperties.AutomationId="TopNavFileButton"
                Style="{StaticResource TopNavButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem AutomationProperties.AutomationId="FileOpenMenuItem" Text="{x:Bind ViewModel.Labels.Open, Mode=OneWay}" Command="{x:Bind ViewModel.OpenCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="FileSaveMenuItem" Text="{x:Bind ViewModel.Labels.Save, Mode=OneWay}" Command="{x:Bind ViewModel.SaveDocumentCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="FileSaveAsMenuItem" Text="{x:Bind ViewModel.Labels.SaveAs, Mode=OneWay}" Command="{x:Bind ViewModel.SaveDocumentAsCommand, Mode=OneWay}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="FileMergeMenuItem" Text="{x:Bind ViewModel.Labels.Merge, Mode=OneWay}" Command="{x:Bind ViewModel.MergeCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="FilePrintMenuItem" Text="{x:Bind ViewModel.Labels.Print, Mode=OneWay}" Command="{x:Bind ViewModel.PrintCommand, Mode=OneWay}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="FileCloseTabMenuItem" Text="{x:Bind ViewModel.Labels.CloseTab, Mode=OneWay}" Click="OnCloseActiveTabMenuClicked" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Grid>
          <Button Content="{x:Bind ViewModel.Labels.RibbonHome, Mode=OneWay}"
                  AutomationProperties.AutomationId="TopNavHomeButton"
                  Style="{StaticResource TopNavButtonStyle}"
                  FontWeight="SemiBold" />
          <Rectangle Height="3"
                     Fill="{ThemeResource AccentBrush}"
                     VerticalAlignment="Bottom"
                     Margin="14,0"
                     RadiusX="1"
                     RadiusY="1"
                     Opacity="0.8">
            <Rectangle.OpacityTransition>
              <ScalarTransition Duration="0:0:0.15" />
            </Rectangle.OpacityTransition>
          </Rectangle>
        </Grid>

        <Button Content="{x:Bind ViewModel.Labels.View, Mode=OneWay}"
                AutomationProperties.AutomationId="TopNavViewButton"
                Style="{StaticResource TopNavButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewPagesMenuItem" Text="{x:Bind ViewModel.Labels.Pages, Mode=OneWay}" Command="{x:Bind ViewModel.TogglePagesPanelCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewInfoMenuItem" Text="{x:Bind ViewModel.Labels.Info, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleInfoPanelCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewSearchMenuItem" Text="{x:Bind ViewModel.Labels.Search, Mode=OneWay}" Command="{x:Bind ViewModel.OpenSearchCommand, Mode=OneWay}" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewPageOrganizerMenuItem" Text="{x:Bind ViewModel.Labels.PageOrganizer, Mode=OneWay}" Click="OnOpenPageOrganizerClicked" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewZoomFitMenuItem" Text="{x:Bind ViewModel.Labels.ZoomFit, Mode=OneWay}" Command="{x:Bind ViewModel.FitPageCommand, Mode=OneWay}" />
              <MenuFlyoutItem AutomationProperties.AutomationId="ViewZoomActualMenuItem" Text="{x:Bind ViewModel.Labels.ZoomActual, Mode=OneWay}" Command="{x:Bind ViewModel.ActualSizeCommand, Mode=OneWay}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Content="{x:Bind ViewModel.Labels.MenuSelection, Mode=OneWay}"
                AutomationProperties.AutomationId="TopNavSelectionButton"
                Style="{StaticResource TopNavButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionRotateLeftMenuItem" Text="{x:Bind ViewModel.Labels.PageRotateLeft, Mode=OneWay}" Click="OnRibbonRotateLeftClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                      <ScaleTransform ScaleX="-1" />
                    </FontIcon.RenderTransform>
                  </FontIcon>
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionRotateRightMenuItem" Text="{x:Bind ViewModel.Labels.PageRotateRight, Mode=OneWay}" Click="OnRibbonRotateRightClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE7AD;" FontFamily="Segoe Fluent Icons" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionMoveUpMenuItem" Text="{x:Bind ViewModel.Labels.PageMoveUp, Mode=OneWay}" Click="OnThumbnailMoveUpClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionMoveDownMenuItem" Text="{x:Bind ViewModel.Labels.PageMoveDown, Mode=OneWay}" Click="OnThumbnailMoveDownClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE74B;" FontFamily="Segoe Fluent Icons" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <MenuFlyoutItem AutomationProperties.AutomationId="SelectionDeleteMenuItem" Text="{x:Bind ViewModel.Labels.PageDelete, Mode=OneWay}" Click="OnThumbnailDeleteClick">
                <MenuFlyoutItem.Icon>
                  <FontIcon Glyph="&#xE107;" FontFamily="Segoe Fluent Icons" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Content="{x:Bind ViewModel.Labels.Annotate, Mode=OneWay}"
                AutomationProperties.AutomationId="TopNavAnnotateButton"
                Style="{StaticResource TopNavButtonStyle}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateSelectMenuItem" Text="{x:Bind ViewModel.Labels.Select, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Select" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateHighlightMenuItem" Text="{x:Bind ViewModel.Labels.Highlight, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Highlight" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateInkMenuItem" Text="{x:Bind ViewModel.Labels.Ink, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Ink" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateTextMenuItem" Text="{x:Bind ViewModel.Labels.Text, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Text" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateNoteMenuItem" Text="{x:Bind ViewModel.Labels.Note, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Note" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateRectangleMenuItem" Text="{x:Bind ViewModel.Labels.Rectangle, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Rectangle" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateSignatureMenuItem" Text="{x:Bind ViewModel.Labels.Signature, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Signature" />
              <MenuFlyoutItem AutomationProperties.AutomationId="AnnotateStampMenuItem" Text="{x:Bind ViewModel.Labels.Stamp, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAnnotationToolCommand, Mode=OneWay}" CommandParameter="Stamp" />
              <MenuFlyoutSeparator />
