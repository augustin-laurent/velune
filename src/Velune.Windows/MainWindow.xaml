                      AutomationProperties.AutomationId="PagesPanelCloseButton"
                      Height="28"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Command="{x:Bind ViewModel.TogglePagesPanelCommand, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ViewModel.Labels.CloseTab, Mode=OneWay}">
                <FontIcon Glyph="&#xE8BB;"
                          FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource TextSecondaryBrush}"
                          FontSize="14" />
              </Button>
            </StackPanel>
          </Grid>

